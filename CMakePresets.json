{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja",
      "displayName": "Ninja (Release)",
      "description": "Ninja generator, Release build in build/.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja (Debug)",
      "description": "Ninja generator, Debug build in build-debug/.",
      "inherits": "ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-asan",
      "displayName": "Ninja (ASan/UBSan)",
      "description": "Ninja generator with AddressSanitizer and UndefinedBehaviorSanitizer.",
      "inherits": "ninja-debug",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "OSKEL_WERROR": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "ninja-gc-stress",
      "displayName": "Ninja (GC stress)",
      "description": "Ninja generator with the cycle collector running at every safe point.",
      "inherits": "ninja",
      "binaryDir": "${sourceDir}/build-gc-stress",
      "cacheVariables": {
        "OSKEL_GC_STRESS": "ON",
        "OSKEL_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja",
      "configurePreset": "ninja"
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "ninja-asan",
      "configurePreset": "ninja-asan"
    },
    {
      "name": "ninja-gc-stress",
      "configurePreset": "ninja-gc-stress"
    }
  ],
  "testPresets": [
    {
      "name": "ninja",
      "configurePreset": "ninja",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-asan",
      "configurePreset": "ninja-asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "ninja-gc-stress",
      "configurePreset": "ninja-gc-stress",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "gc-stress-slow"
        }
      }
    }
  ]
}
