{
  "name": "oskel",
  "displayName": "Oskel",
  "description": "Oskel language support for VS Code: syntax highlighting, editor configuration and snippets (.oskl).",
  "version": "0.1.0",
  "publisher": "oskel-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasmramos/Oskel.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["oskel", "language", "syntax", "highlighting", "snippets"],
  "contributes": {
    "languages": [
      {
        "id": "oskel",
        "aliases": ["Oskel", "oskel"],
        "extensions": [".oskl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oskel",
        "scopeName": "source.oskl",
        "path": "./syntaxes/oskel.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "oskel",
        "path": "./snippets/oskel.json"
      }
    ],
    "configurationDefaults": {
      "[oskel]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.guides.bracketPairs": true,
        "editor.comments.insertSpace": true
      }
    }
  }
}
