{
  "name": "oskel",
  "displayName": "Oskel",
  "description": "Oskel language support for VS Code: syntax highlighting, editor configuration, snippets and compiler diagnostics (.oskl).",
  "version": "0.2.0",
  "publisher": "oskel-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasmramos/Oskel.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:oskel"],
  "categories": ["Programming Languages", "Linters"],
  "keywords": ["oskel", "language", "syntax", "highlighting", "snippets", "diagnostics"],
  "contributes": {
    "languages": [
      {
        "id": "oskel",
        "aliases": ["Oskel", "oskel"],
        "extensions": [".oskl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oskel",
        "scopeName": "source.oskl",
        "path": "./syntaxes/oskel.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "oskel",
        "path": "./snippets/oskel.json"
      }
    ],
    "configurationDefaults": {
      "[oskel]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.guides.bracketPairs": true,
        "editor.comments.insertSpace": true
      }
    },
    "commands": [
      {
        "command": "oskel.checkFile",
        "title": "Check file",
        "category": "Oskel"
      },
      {
        "command": "oskel.clearDiagnostics",
        "title": "Clear diagnostics",
        "category": "Oskel"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "oskel.checkFile",
          "when": "editorLangId == oskel"
        },
        {
          "command": "oskel.clearDiagnostics",
          "when": "editorLangId == oskel"
        }
      ]
    },
    "configuration": {
      "title": "Oskel",
      "properties": {
        "oskel.check.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report compiler errors and warnings as editor diagnostics."
        },
        "oskel.check.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Run the compiler in check mode every time an Oskel file is saved."
        },
        "oskel.check.path": {
          "type": "string",
          "default": "",
          "description": "Path to the 'oskel' compiler. Empty uses the one on PATH; a relative path resolves against the first workspace folder. 'oskelc' has no check mode."
        }
      }
    }
  }
}
