// Internal Skia backend for the display list produced by `std.ui`.
//
// `std.ui.window` reaches this module through `std.internal.skia_window`; it
// is not public API. The backend owns the Skia objects it creates and closes
// them before it returns. It only understands the two commands `std.ui` emits
// today: `rect` and `text`.

import std.internal.skia as skia;

fn render(commands, canvas) {
  for cmd in commands {
    if (cmd.kind == "rect") {
      let paint = skia.Paint();
      paint.setAntiAlias(false);
      paint.setColor(cmd.color);
      let rect = skia.Rects.make(cmd.x, cmd.y, cmd.x + cmd.w, cmd.y + cmd.h);
      canvas.drawRect(rect, paint);
      rect.close();
      paint.close();
    } else if (cmd.kind == "text") {
      let paint = skia.Paint();
      paint.setAntiAlias(true);
      paint.setColor(cmd.color);
      let font = skia.Font();
      font.setSize(cmd.size);
      skia.drawText(canvas, cmd.text, cmd.x, cmd.y, font, paint);
      font.close();
      paint.close();
    }
  }
}
