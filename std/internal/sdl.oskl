// Internal standard library: SDL3.
//
// This module is an implementation detail of the UI backend; user code imports
// `std.ui` (widgets) and `std.ui.window` (the event loop), never this module.
// Imported internally as `import std.internal.sdl as sdl;` (qualified:
// `sdl.SDL_Init`). It binds the window, renderer, texture and event surface of
// SDL3. It is opt-in: only a module that imports it resolves the `SDL_*`
// symbols, and the engine must have SDL3 loaded (the development engine links
// it when CMake finds it; a native binary needs
// `oskel build --mode hosted --link-lib SDL3`).
//
// The `extern "C"` block below is generated by `bindgen` from
// `bindings/sdl/sdl3_subset.h`; regenerate it with
// `./build/bindgen bindings/sdl/sdl3_subset.h` and replace the block. The
// helpers after it are hand-written and are not part of the generated output.
//
// SDL3 is float-based where SDL2 used integers: the renderer's rectangle is an
// `SDL_FRect` (four binary32 values) and the event coordinates are floats.
// `storeF32`/`loadF32` encode and decode IEEE 754 in Oskel, so no builtin is
// needed and the VM and the AOT backend agree by construction.
//
// Event layout (SDL3 3.x, the same on every target because the SDL types are
// fixed-width). `SDL_Event` is a union, so it stays an opaque `ptr` and the
// accessors below read these offsets out of a 128-byte buffer:
//
//   type          @ 0    (Uint32)
//   key.scancode  @ 24   (Sint32)
//   key.key       @ 28   (Sint32)
//   motion.x      @ 28   (float)
//   motion.y      @ 32   (float)
//   button.button @ 24   (Uint8)
//   button.down   @ 25   (bool)
//   button.x      @ 28   (float)
//   button.y      @ 32   (float)
//
// `SDL_ReadSurfacePixel` and `SDL_WriteSurfacePixel` take seven arguments, so
// they exercise the FFI's seventh-GPR stack spill.
//
// A frame reaches the screen through a streaming `SDL_Texture`: the backend
// copies a tightly packed 32-bit pixel buffer with `SDL_UpdateTexture`, draws
// the texture with `SDL_RenderTexture`, and presents the renderer.

// --- Generated by bindgen from bindings/sdl/sdl3_subset.h. Do not edit. ---

extern "C" {
  fn SDL_Init(flags: uint32): bool;
  fn SDL_Quit(): void;
  fn SDL_GetError(): cstring;
  fn SDL_CreateWindow(title: cstring, w: int32, h: int32, flags: uint64): ptr;
  fn SDL_DestroyWindow(window: ptr): void;
  fn SDL_SetWindowTitle(window: ptr, title: cstring): bool;
  fn SDL_SetWindowPosition(window: ptr, x: int32, y: int32): bool;
  fn SDL_GetWindowSize(window: ptr, w: ptr, h: ptr): bool;
  fn SDL_CreateSurface(width: int32, height: int32, format: uint32): ptr;
  fn SDL_DestroySurface(surface: ptr): void;
  fn SDL_ReadSurfacePixel(surface: ptr, x: int32, y: int32, r: ptr, g: ptr, b: ptr, a: ptr): bool;
  fn SDL_WriteSurfacePixel(surface: ptr, x: int32, y: int32, r: uint8, g: uint8, b: uint8, a: uint8): bool;
  fn SDL_CreateRenderer(window: ptr, name: cstring): ptr;
  fn SDL_DestroyRenderer(renderer: ptr): void;
  fn SDL_SetRenderVSync(renderer: ptr, vsync: int32): bool;
  fn SDL_SetRenderDrawColor(renderer: ptr, r: uint8, g: uint8, b: uint8, a: uint8): bool;
  fn SDL_RenderClear(renderer: ptr): bool;
  fn SDL_RenderPoint(renderer: ptr, x: float, y: float): bool;
  fn SDL_RenderLine(renderer: ptr, x1: float, y1: float, x2: float, y2: float): bool;
  fn SDL_RenderRect(renderer: ptr, rect: ptr): bool;
  fn SDL_RenderFillRect(renderer: ptr, rect: ptr): bool;
  fn SDL_RenderPresent(renderer: ptr): bool;
  fn SDL_CreateTexture(renderer: ptr, format: uint32, access: int32, w: int32, h: int32): ptr;
  fn SDL_DestroyTexture(texture: ptr): void;
  fn SDL_UpdateTexture(texture: ptr, rect: ptr, pixels: ptr, pitch: int32): bool;
  fn SDL_RenderTexture(renderer: ptr, texture: ptr, srcrect: ptr, dstrect: ptr): bool;
  fn SDL_PollEvent(event: ptr): bool;
  fn SDL_PushEvent(event: ptr): bool;
  fn SDL_GetTicks(): uint64;
  fn SDL_Delay(ms: uint32): void;
}

// --- Hand-written helpers (not generated) ---

// `SDL_Init` flags.
const SDL_INIT_VIDEO = 0x00000020;

// `SDL_PIXELFORMAT_ABGR8888`: a concrete 32-bit RGBA format, so the surface
// tests do not depend on the endian-dependent `SDL_PIXELFORMAT_RGBA32` alias.
const SDL_PIXELFORMAT_ABGR8888 = 0x16762004;

// `SDL_PIXELFORMAT_ARGB8888`: 0xAARRGGBB. On a little-endian target its memory
// order is B, G, R, A, which is exactly Skia's `kBGRA_8888` readback.
const SDL_PIXELFORMAT_ARGB8888 = 0x16362004;

// `SDL_TextureAccess`: a streaming texture is updated every frame.
const SDL_TEXTUREACCESS_STREAMING = 1;

// `SDL_BUTTON_LEFT` (`SDL_MouseButtonFlags`).
const SDL_BUTTON_LEFT = 1;

// `SDL_WindowFlags` (Uint64).
const SDL_WINDOW_FULLSCREEN = 0x00000001;
const SDL_WINDOW_HIDDEN = 0x00000008;
const SDL_WINDOW_RESIZABLE = 0x00000020;
const SDL_WINDOW_HIGH_PIXEL_DENSITY = 0x00002000;

// Event types.
const SDL_EVENT_QUIT = 0x00000100;
const SDL_EVENT_WINDOW_MOUSE_LEAVE = 0x0000020D;
const SDL_EVENT_WINDOW_FOCUS_LOST = 0x0000020F;
const SDL_EVENT_KEY_DOWN = 0x00000300;
const SDL_EVENT_KEY_UP = 0x00000301;
const SDL_EVENT_MOUSE_MOTION = 0x00000400;
const SDL_EVENT_MOUSE_BUTTON_DOWN = 0x00000401;
const SDL_EVENT_MOUSE_BUTTON_UP = 0x00000402;

// Keycodes (`SDL_Keycode`, the layout-independent `key` field).
const SDLK_ESCAPE = 27;
const SDLK_RETURN = 13;
const SDLK_SPACE = 32;

// Layout constants. `SDL_EVENT_BYTES` is `sizeof(SDL_Event)` in SDL3 3.x.
const SDL_EVENT_BYTES = 128;
const SDL_FRECT_BYTES = 16;
const SDL_EVENT_TYPE_OFFSET = 0;
const SDL_EVENT_SCANCODE_OFFSET = 24;
const SDL_EVENT_KEY_OFFSET = 28;
const SDL_EVENT_MOTION_X_OFFSET = 28;
const SDL_EVENT_MOTION_Y_OFFSET = 32;
const SDL_EVENT_BUTTON_OFFSET = 24;
const SDL_EVENT_BUTTON_DOWN_OFFSET = 25;
const SDL_EVENT_BUTTON_X_OFFSET = 28;
const SDL_EVENT_BUTTON_Y_OFFSET = 32;

// Little-endian 32-bit accessors over the byte buffer the pointer builtins own.
fn loadU32(buffer: ptr, offset: int): int {
  return loadByte(buffer, offset)
       | (loadByte(buffer, offset + 1) << 8)
       | (loadByte(buffer, offset + 2) << 16)
       | (loadByte(buffer, offset + 3) << 24);
}

fn storeU32(buffer: ptr, offset: int, value: int): void {
  storeByte(buffer, offset, value & 255);
  storeByte(buffer, offset + 1, (value >> 8) & 255);
  storeByte(buffer, offset + 2, (value >> 16) & 255);
  storeByte(buffer, offset + 3, (value >> 24) & 255);
}

// IEEE 754 binary32, encoded in Oskel so the AOT backend and the VM share one
// implementation. Coordinates are small normal numbers; a subnormal decodes as
// zero, which is the right answer for the values a UI produces. Inf and NaN are
// encoded explicitly: without the guard, normalizing an infinity would loop.
fn storeF32(buffer: ptr, offset: int, value: float): void {
  var v = value;
  if (v != v) {
    storeU32(buffer, offset, 0x7FC00000);
    return;
  }
  if (v == 0.0f) {
    storeU32(buffer, offset, 0);
    return;
  }
  var sign = 0;
  if (v < 0.0f) {
    sign = 0x80000000;
    v = -v;
  }
  var exponent = 0;
  while (v >= 2.0f && exponent < 128) {
    v = v / 2.0f;
    exponent = exponent + 1;
  }
  if (exponent >= 128) {
    storeU32(buffer, offset, sign | 0x7F800000);
    return;
  }
  while (v < 1.0f) {
    v = v * 2.0f;
    exponent = exponent - 1;
  }
  let mantissa = int((v - 1.0f) * 8388608.0f);
  storeU32(buffer, offset, sign | ((exponent + 127) << 23) | mantissa);
}

fn loadF32(buffer: ptr, offset: int): float {
  let bits = loadU32(buffer, offset);
  let sign = (bits >> 31) & 1;
  let exponent = (bits >> 23) & 255;
  if (exponent == 0) {
    return 0.0f;
  }
  let mantissa = bits & 0x7FFFFF;
  var value = 1.0f + float(mantissa) / 8388608.0f;
  var e = exponent - 127;
  while (e > 0) {
    value = value * 2.0f;
    e = e - 1;
  }
  while (e < 0) {
    value = value / 2.0f;
    e = e + 1;
  }
  if (sign == 1) {
    return -value;
  }
  return value;
}

// A reusable `SDL_Event` buffer. Allocate one and pass it to every
// `SDL_PollEvent`, so a frame loop does not allocate per event.
fn eventBuffer(): ptr {
  return buffer(SDL_EVENT_BYTES);
}

// A reusable `SDL_FRect` buffer. `setFRect` fills it; `fillRect`/`drawRect`
// consume it. Reusing it keeps a frame loop allocation-free in AOT, whose
// arena only grows.
fn fRectBuffer(): ptr {
  return buffer(SDL_FRECT_BYTES);
}

fn setFRect(rect: ptr, x: double, y: double, w: double, h: double): void {
  storeF32(rect, 0, float(x));
  storeF32(rect, 4, float(y));
  storeF32(rect, 8, float(w));
  storeF32(rect, 12, float(h));
}

fn eventType(event: ptr): int {
  return loadU32(event, SDL_EVENT_TYPE_OFFSET);
}

fn keyScancode(event: ptr): int {
  return loadU32(event, SDL_EVENT_SCANCODE_OFFSET);
}

fn keyCode(event: ptr): int {
  return loadU32(event, SDL_EVENT_KEY_OFFSET);
}

fn mouseX(event: ptr): float {
  return loadF32(event, SDL_EVENT_MOTION_X_OFFSET);
}

fn mouseY(event: ptr): float {
  return loadF32(event, SDL_EVENT_MOTION_Y_OFFSET);
}

fn mouseButton(event: ptr): int {
  return loadByte(event, SDL_EVENT_BUTTON_OFFSET);
}

fn mouseButtonDown(event: ptr): bool {
  return loadByte(event, SDL_EVENT_BUTTON_DOWN_OFFSET) != 0;
}

// Thin wrappers that keep the call sites readable and convert the integer
// coordinates a UI works with to the floats SDL3 expects.
fn initVideo(): bool {
  return SDL_Init(SDL_INIT_VIDEO);
}

fn quit(): void {
  SDL_Quit();
}

fn lastError(): string {
  return cstr(SDL_GetError());
}

fn ticks(): int {
  return int(SDL_GetTicks());
}

fn delayMs(ms: int): void {
  SDL_Delay(ms);
}

fn setColor(renderer: ptr, r: int, g: int, b: int, a: int): bool {
  return SDL_SetRenderDrawColor(renderer, r, g, b, a);
}

fn clear(renderer: ptr): bool {
  return SDL_RenderClear(renderer);
}

fn fillRect(renderer: ptr, rect: ptr): bool {
  return SDL_RenderFillRect(renderer, rect);
}

fn drawRect(renderer: ptr, rect: ptr): bool {
  return SDL_RenderRect(renderer, rect);
}

fn drawLine(renderer: ptr, x1: double, y1: double, x2: double, y2: double): bool {
  return SDL_RenderLine(renderer, float(x1), float(y1), float(x2), float(y2));
}

fn drawPoint(renderer: ptr, x: double, y: double): bool {
  return SDL_RenderPoint(renderer, float(x), float(y));
}

fn present(renderer: ptr): bool {
  return SDL_RenderPresent(renderer);
}

fn createTexture(renderer: ptr, format: int, access: int, w: int, h: int): ptr {
  return SDL_CreateTexture(renderer, format, access, w, h);
}

fn destroyTexture(texture: ptr): void {
  SDL_DestroyTexture(texture);
}

fn updateTexture(texture: ptr, pixels: ptr, pitch: int): bool {
  return SDL_UpdateTexture(texture, nil, pixels, pitch);
}

fn renderTexture(renderer: ptr, texture: ptr): bool {
  return SDL_RenderTexture(renderer, texture, nil, nil);
}
