// Standard library: hashes and message authentication.
//
// Imported as `import std.hash;` (qualified: `std.hash.sha256`),
// `import std.hash.*;` (unqualified: `sha256`), `import std.hash as h;` or
// `import { sha256Hex, hmacSha256Hex } from std.hash;`.
//
// Every function accepts either a string (hashed as its UTF-8 bytes) or an
// array of bytes in `0..255`, and returns the digest as an array of bytes.
// The `...Hex` forms return lowercase hexadecimal text, and `crc32` returns an
// unsigned 32-bit integer.
//
// SHA-256, SHA-1 and HMAC-SHA256 are implemented over 32-bit arithmetic
// (`&`, `|`, `^`, `<<`, `>>`, `~`), so the module is plain Oskel and behaves
// identically on the development VM, under `oskel build` and on WebAssembly.
// SHA-1 is provided for legacy protocols and UUID v5; use SHA-256 for new
// designs. The hashes are not constant-time, and `constantTimeEqual` is the
// comparison helper for a tag or a digest that an attacker can time.
//
// The module is not a replacement for a vetted crypto library when the
// threat model needs one: it has no SHA-512, no key derivation and no
// streaming API. A digest of a few kilobytes is fast enough; hashing a large
// file in one call copies the whole input into the padding buffer.

import std.bytes as _bytes;

// --- SHA-256 ----------------------------------------------------------------

let _K256 = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

let _H256 = [
  0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

// Rotate a 32-bit word right by `n` bits. The mask drops the bits a left
// shift pushes past bit 31, which is what keeps the result a 32-bit word.
fn _rotr32(x, n) {
  return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF;
}

// Rotate a 32-bit word left by `n` bits.
fn _rotl32(x, n) {
  return ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF;
}

// A copy of `input` (a string or a byte array) as a byte array. The public
// functions share this validation, so the message names the caller.
@MustUse
fn _inputBytes(input, name) {
  if (type(input) == "string") {
    return _bytes.fromString(input);
  }
  if (!_bytes.isValid(input)) {
    panic("std.hash." + name + ": expected a string or an array of bytes");
  }
  return input;
}

// The SHA-256 padding: the message, `0x80`, zero bytes up to 56 modulo 64 and
// the bit length as a big-endian 64-bit integer.
@MustUse
fn _pad64(bytes) {
  let bitLen = len(bytes) * 8;
  var out = [];
  for b in bytes {
    out[len(out)] = b;
  }
  out[len(out)] = 0x80;
  while (len(out) % 64 != 56) {
    out[len(out)] = 0;
  }
  var shift = 56;
  while (shift >= 0) {
    out[len(out)] = (bitLen >> shift) & 0xFF;
    shift = shift - 8;
  }
  return out;
}

// The big-endian 32-bit word at `offset`.
@MustUse
fn _wordBE(bytes, offset) {
  return (bytes[offset] << 24) | (bytes[offset + 1] << 16)
    | (bytes[offset + 2] << 8) | bytes[offset + 3];
}

// Appends the four big-endian bytes of `word`.
fn _pushWordBE(out, word) {
  out[len(out)] = (word >> 24) & 0xFF;
  out[len(out)] = (word >> 16) & 0xFF;
  out[len(out)] = (word >> 8) & 0xFF;
  out[len(out)] = word & 0xFF;
}

// The 32-byte SHA-256 digest of a byte array.
@MustUse
fn _sha256(bytes) {
  let msg = _pad64(bytes);
  var h0 = _H256[0];
  var h1 = _H256[1];
  var h2 = _H256[2];
  var h3 = _H256[3];
  var h4 = _H256[4];
  var h5 = _H256[5];
  var h6 = _H256[6];
  var h7 = _H256[7];
  var offset = 0;
  while (offset < len(msg)) {
    var w = [];
    var i = 0;
    while (i < 16) {
      w[len(w)] = _wordBE(msg, offset + i * 4);
      i = i + 1;
    }
    while (i < 64) {
      let s0 = _rotr32(w[i - 15], 7) ^ _rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
      let s1 = _rotr32(w[i - 2], 17) ^ _rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
      w[len(w)] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xFFFFFFFF;
      i = i + 1;
    }
    var a = h0;
    var b = h1;
    var c = h2;
    var d = h3;
    var e = h4;
    var f = h5;
    var g = h6;
    var h = h7;
    i = 0;
    while (i < 64) {
      let S1 = _rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25);
      let ch = (e & f) ^ ((e ^ 0xFFFFFFFF) & g);
      let t1 = (h + S1 + ch + _K256[i] + w[i]) & 0xFFFFFFFF;
      let S0 = _rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22);
      let maj = (a & b) ^ (a & c) ^ (b & c);
      let t2 = (S0 + maj) & 0xFFFFFFFF;
      h = g;
      g = f;
      f = e;
      e = (d + t1) & 0xFFFFFFFF;
      d = c;
      c = b;
      b = a;
      a = (t1 + t2) & 0xFFFFFFFF;
      i = i + 1;
    }
    h0 = (h0 + a) & 0xFFFFFFFF;
    h1 = (h1 + b) & 0xFFFFFFFF;
    h2 = (h2 + c) & 0xFFFFFFFF;
    h3 = (h3 + d) & 0xFFFFFFFF;
    h4 = (h4 + e) & 0xFFFFFFFF;
    h5 = (h5 + f) & 0xFFFFFFFF;
    h6 = (h6 + g) & 0xFFFFFFFF;
    h7 = (h7 + h) & 0xFFFFFFFF;
    offset = offset + 64;
  }
  var out = [];
  _pushWordBE(out, h0);
  _pushWordBE(out, h1);
  _pushWordBE(out, h2);
  _pushWordBE(out, h3);
  _pushWordBE(out, h4);
  _pushWordBE(out, h5);
  _pushWordBE(out, h6);
  _pushWordBE(out, h7);
  return out;
}

// --- SHA-1 ------------------------------------------------------------------

let _H1 = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0];

// The 20-byte SHA-1 digest of a byte array. Legacy: keep it for protocols and
// UUID v5, not for a new signature.
@MustUse
fn _sha1(bytes) {
  let msg = _pad64(bytes);
  var h0 = _H1[0];
  var h1 = _H1[1];
  var h2 = _H1[2];
  var h3 = _H1[3];
  var h4 = _H1[4];
  var offset = 0;
  while (offset < len(msg)) {
    var w = [];
    var i = 0;
    while (i < 16) {
      w[len(w)] = _wordBE(msg, offset + i * 4);
      i = i + 1;
    }
    while (i < 80) {
      w[len(w)] = _rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
      i = i + 1;
    }
    var a = h0;
    var b = h1;
    var c = h2;
    var d = h3;
    var e = h4;
    i = 0;
    while (i < 80) {
      var f = 0;
      var k = 0;
      if (i < 20) {
        f = (b & c) | ((b ^ 0xFFFFFFFF) & d);
        k = 0x5A827999;
      } else if (i < 40) {
        f = b ^ c ^ d;
        k = 0x6ED9EBA1;
      } else if (i < 60) {
        f = (b & c) | (b & d) | (c & d);
        k = 0x8F1BBCDC;
      } else {
        f = b ^ c ^ d;
        k = 0xCA62C1D6;
      }
      let temp = (_rotl32(a, 5) + f + e + k + w[i]) & 0xFFFFFFFF;
      e = d;
      d = c;
      c = _rotl32(b, 30);
      b = a;
      a = temp;
      i = i + 1;
    }
    h0 = (h0 + a) & 0xFFFFFFFF;
    h1 = (h1 + b) & 0xFFFFFFFF;
    h2 = (h2 + c) & 0xFFFFFFFF;
    h3 = (h3 + d) & 0xFFFFFFFF;
    h4 = (h4 + e) & 0xFFFFFFFF;
    offset = offset + 64;
  }
  var out = [];
  _pushWordBE(out, h0);
  _pushWordBE(out, h1);
  _pushWordBE(out, h2);
  _pushWordBE(out, h3);
  _pushWordBE(out, h4);
  return out;
}

// --- HMAC -------------------------------------------------------------------

// `left ++ right` over byte arrays.
@MustUse
fn _concat(left, right) {
  var out = [];
  for b in left {
    out[len(out)] = b;
  }
  for b in right {
    out[len(out)] = b;
  }
  return out;
}

// HMAC-SHA256 (RFC 2104): `H((K ^ opad) ++ H((K ^ ipad) ++ message))`. A key
// longer than the 64-byte block is hashed first, and a short key is padded
// with zeros.
@MustUse
fn _hmacSha256(key, message) {
  var k = _inputBytes(key, "hmacSha256");
  if (len(k) > 64) {
    k = _sha256(k);
  }
  while (len(k) < 64) {
    k[len(k)] = 0;
  }
  var ipad = [];
  var opad = [];
  for b in k {
    ipad[len(ipad)] = b ^ 0x36;
    opad[len(opad)] = b ^ 0x5C;
  }
  return _sha256(_concat(opad, _sha256(_concat(ipad, _inputBytes(message, "hmacSha256")))));
}

// --- public surface ---------------------------------------------------------

// The SHA-256 digest of a string (UTF-8) or a byte array, as 32 bytes.
@MustUse
fn sha256(input) {
  return _sha256(_inputBytes(input, "sha256"));
}

// The SHA-256 digest as 64 lowercase hexadecimal characters.
@MustUse
fn sha256Hex(input) {
  return _bytes.hexEncode(sha256(input));
}

// The SHA-1 digest of a string (UTF-8) or a byte array, as 20 bytes.
@MustUse
fn sha1(input) {
  return _sha1(_inputBytes(input, "sha1"));
}

// The SHA-1 digest as 40 lowercase hexadecimal characters.
@MustUse
fn sha1Hex(input) {
  return _bytes.hexEncode(sha1(input));
}

// The HMAC-SHA256 tag of `message` under `key`, as 32 bytes. Both arguments
// accept a string (UTF-8) or a byte array.
@MustUse
fn hmacSha256(key, message) {
  return _hmacSha256(key, message);
}

// The HMAC-SHA256 tag as 64 lowercase hexadecimal characters.
@MustUse
fn hmacSha256Hex(key, message) {
  return _bytes.hexEncode(hmacSha256(key, message));
}

// The CRC-32 (IEEE 802.3) checksum of a string or byte array, as an unsigned
// 32-bit integer. Not a cryptographic hash.
@MustUse
fn crc32(input) {
  let data = _inputBytes(input, "crc32");
  var crc = 0xFFFFFFFF;
  for b in data {
    crc = crc ^ b;
    var i = 0;
    while (i < 8) {
      if ((crc & 1) != 0) {
        crc = (crc >> 1) ^ 0xEDB88320;
      } else {
        crc = crc >> 1;
      }
      i = i + 1;
    }
  }
  return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

// True when two byte strings (or strings) have the same length and bytes.
// The loop does not stop at the first difference, so the running time does not
// depend on where the inputs differ; use it to compare a MAC or a digest.
@MustUse
fn constantTimeEqual(left, right) {
  let a = _inputBytes(left, "constantTimeEqual");
  let b = _inputBytes(right, "constantTimeEqual");
  if (len(a) != len(b)) {
    return false;
  }
  var diff = 0;
  var i = 0;
  while (i < len(a)) {
    diff = diff | (a[i] ^ b[i]);
    i = i + 1;
  }
  return diff == 0;
}
