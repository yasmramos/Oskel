// Standard library: filesystem paths.
//
// Imported as `import std.path;` (qualified: `std.path.join`),
// `import std.path.*;` (unqualified: `join`), `import std.path as p;` or
// `import { join, basename } from std.path;`.
//
// A path is an ordinary string, not a new type: the result of `join` feeds
// `readFile`/`writeFile`/`fileExists` directly, and a path nests in a
// collection, compares and interpolates like any other string. Keeping it a
// string is what lets this module compose with the file builtins without a
// wrapper to unwrap.
//
// The separator is `/` on every platform. Windows accepts `/` in every API
// this language reaches (the file builtins and the C runtime both do), so a
// single separator keeps the module deterministic and portable; a Windows path
// that already uses `\` is normalised to `/` on the way in (see `_toSlashes`).
//
// The module is pure Oskel over the portable primitive surface (indexing,
// slicing, `len`, `ord`/`chr`, `str`, `panic`, `for ... in`, closures), so it
// behaves identically on the development VM and under `oskel build` on every
// AOT target. It deliberately avoids the collection and string methods
// (`.split`, `.join`, ...) and the `pcall` builtin, which the AOT
// backend does not implement yet (DEVELOPMENT.md PHASE 7f).
//
// Deviations from POSIX `posixpath`, all deliberate:
//   - `basename("a/b/")` is `"b"`, not `""`: a trailing separator is ignored,
//     which is what Rust's `Path::file_name` does and what a caller expects.
//     `dirname` follows the same rule, so the two stay inverse.
//   - `dirname("a")` is `"."`, not `""`: the parent of a bare name is the
//     current directory.
//   - `join("a", "/b")` is `"a/b"`, not `"/b"`: a separator between parts
//     collapses instead of discarding the parts before it. Building a path
//     from pieces never silently drops one.
// `normalize` and `relative` match `posixpath.normpath`/`relpath` exactly.

const _SEP = "/";

// Windows spells the separator `\`. The file builtins and the C runtime accept
// `/` everywhere, so a `\` is folded to `/` before anything else looks at the
// path; a drive letter (`C:\a`) keeps its colon and becomes `C:/a`.
fn _toSlashes(p) {
  var out = "";
  for c in p {
    out = out + (c == "\\" ? _SEP : c);
  }
  return out;
}

// Collapses a run of separators into one. A leading separator survives (so an
// absolute path stays absolute); `//a` becomes `/a` and `a//b` becomes `a/b`.
fn _collapseSlashes(p) {
  var out = "";
  var previousWasSlash = false;
  for c in p {
    if (c == _SEP) {
      if (!previousWasSlash) {
        out = out + _SEP;
      }
      previousWasSlash = true;
    } else {
      out = out + c;
      previousWasSlash = false;
    }
  }
  return out;
}

// The number of trailing separators to keep: every one is dropped except the
// single separator that names the root. `end` is the exclusive index into `p`.
fn _trimmedEnd(p) {
  var end = len(p);
  while (end > 1 && p[end - 1] == _SEP) {
    end = end - 1;
  }
  return end;
}

// --- joining ---------------------------------------------------------------

// Concatenates the parts with the separator, dropping empty parts and
// collapsing the separators between them. A leading separator in the first
// non-empty part makes the result absolute, and a `\` inside a part is folded
// to `/` like everywhere else in this module.
//
//   join("a", "b", "c")   -> "a/b/c"
//   join("a/", "/b")      -> "a/b"
//   join("/", "usr", "bin") -> "/usr/bin"
//   join("a", "", "b")    -> "a/b"
//   join()                -> ""
@MustUse
fn join(rest...) {
  var raw = "";
  for part in rest {
    if (part == "") {
      continue;
    }
    if (raw != "") {
      raw = raw + _SEP;
    }
    raw = raw + part;
  }
  return _collapseSlashes(_toSlashes(raw));
}

// --- components ------------------------------------------------------------

// The last component of the path. Trailing separators are ignored, so
// `basename("a/b/")` is `b`; the root keeps its separator.
//
//   basename("/a/b/c.txt") -> "c.txt"
//   basename("/a/b/")      -> "b"
//   basename("/")          -> "/"
//   basename("a")          -> "a"
@MustUse
fn basename(p) {
  let text = _toSlashes(p);
  if (text == "") {
    return "";
  }
  let s = text[0:_trimmedEnd(text)];
  if (s == _SEP) {
    return _SEP;
  }
  var i = len(s) - 1;
  while (i >= 0 && s[i] != _SEP) {
    i = i - 1;
  }
  return s[i + 1:len(s)];
}

// Everything up to the last separator. A path with no separator has the
// current directory `.` for a parent, and the parent of the root is the root.
//
//   dirname("/a/b/c.txt") -> "/a/b"
//   dirname("/a")         -> "/"
//   dirname("a/b")        -> "a"
//   dirname("a")          -> "."
@MustUse
fn dirname(p) {
  let text = _toSlashes(p);
  if (text == "") {
    return ".";
  }
  let s = text[0:_trimmedEnd(text)];
  var i = len(s) - 1;
  while (i >= 0 && s[i] != _SEP) {
    i = i - 1;
  }
  if (i < 0) {
    return ".";
  }
  // Drop the run of separators that precedes the last component.
  var end = i;
  while (end > 0 && s[end - 1] == _SEP) {
    end = end - 1;
  }
  let head = s[0:end];
  if (head == "") {
    return _SEP;
  }
  return head;
}

// The extension of the last component, **including** the leading dot. A dot at
// the start of the component is not an extension (a dotfile such as `.bashrc`
// has none), and only the last dot counts (`a.tar.gz` -> `.gz`). An empty
// string means there is no extension.
//
//   extension("/a/b/c.txt") -> ".txt"
//   extension("a.tar.gz")   -> ".gz"
//   extension("noext")      -> ""
//   extension(".bashrc")    -> ""
@MustUse
fn extension(p) {
  let name = basename(p);
  let n = len(name);
  var i = n - 1;
  while (i > 0 && name[i] != ".") {
    i = i - 1;
  }
  if (i <= 0) {
    return "";
  }
  return name[i:n];
}

// The last component without its extension.
//
//   stem("/a/b/c.txt") -> "c"
//   stem("a.tar.gz")   -> "a.tar"
//   stem(".bashrc")    -> ".bashrc"
@MustUse
fn stem(p) {
  let name = basename(p);
  let ext = extension(p);
  if (ext == "") {
    return name;
  }
  return name[0:len(name) - len(ext)];
}

// Replaces the extension of the last component. A non-empty `ext` that does not
// start with a dot gets one, so `withExtension(p, "md")` and
// `withExtension(p, ".md")` agree.
//
//   withExtension("a/b/c.txt", ".md") -> "a/b/c.md"
//   withExtension("c", "md")          -> "c.md"
@MustUse
fn withExtension(p, ext) {
  var suffix = ext;
  if (suffix != "" && suffix[0] != ".") {
    suffix = "." + suffix;
  }
  return _replaceName(p, stem(p) + suffix);
}

// Replaces the last component, keeping the directory.
//
//   withBasename("a/b/c.txt", "d.md") -> "a/b/d.md"
//   withBasename("c.txt", "d.md")     -> "d.md"
@MustUse
fn withBasename(p, name) {
  return _replaceName(p, name);
}

// Rebuilds the path from its directory and a new last component. The directory
// is `dirname`, so the root keeps its separator and a bare name stays bare.
fn _replaceName(p, name) {
  let dir = dirname(p);
  if (dir == ".") {
    return name;
  }
  if (dir == _SEP) {
    return _SEP + name;
  }
  return dir + _SEP + name;
}

// --- decomposition ---------------------------------------------------------

// The path split into components. The root is its own first element, runs of
// separators collapse and trailing separators are dropped, so the result is
// exactly what `normalize` would walk.
//
//   split("/a/b") -> ["/", "a", "b"]
//   split("a/b/") -> ["a", "b"]
//   split("/")    -> ["/"]
//   split("")     -> []
@MustUse
fn split(p) {
  let text = _toSlashes(p);
  var parts = [];
  if (text == "") {
    return parts;
  }
  if (text[0] == _SEP) {
    parts[len(parts)] = _SEP;
  }
  var i = 0;
  while (i < len(text)) {
    while (i < len(text) && text[i] == _SEP) {
      i = i + 1;
    }
    if (i >= len(text)) {
      break;
    }
    let start = i;
    while (i < len(text) && text[i] != _SEP) {
      i = i + 1;
    }
    parts[len(parts)] = text[start:i];
  }
  return parts;
}

// --- predicates ------------------------------------------------------------

// True when the path starts with a separator.
//
//   isAbsolute("/a") -> true
//   isAbsolute("a")  -> false
//   isAbsolute("")   -> false
@MustUse
fn isAbsolute(p) {
  let text = _toSlashes(p);
  return len(text) > 0 && text[0] == _SEP;
}

// True when the path does not start with a separator.
@MustUse
fn isRelative(p) {
  return !isAbsolute(p);
}

// --- normalisation ---------------------------------------------------------

// Resolves `.` and `..` lexically and collapses the separators, without
// touching the filesystem: `..` cancels the preceding component, a leading `..`
// in a relative path is kept, and a `..` at the root of an absolute path is
// dropped. A path that normalises to nothing is `.` (or `/` when absolute).
//
//   normalize("/a/./b/../c") -> "/a/c"
//   normalize("a/../../b")   -> "../b"
//   normalize("a//b/")       -> "a/b"
//   normalize("/..")         -> "/"
@MustUse
fn normalize(p) {
  let absolute = isAbsolute(p);
  let parts = split(p);
  var stack = [];
  var i = absolute ? 1 : 0;
  while (i < len(parts)) {
    let part = parts[i];
    if (part == "..") {
      if (len(stack) > 0 && stack[len(stack) - 1] != "..") {
        stack = stack[0:len(stack) - 1];
      } else if (!absolute) {
        stack[len(stack)] = "..";
      }
      // At the root of an absolute path `..` has nowhere to go: it is dropped.
    } else if (part != ".") {
      stack[len(stack)] = part;
    }
    i = i + 1;
  }
  let body = _joinComponents(stack);
  if (absolute) {
    if (body == "") {
      return _SEP;
    }
    return _SEP + body;
  }
  if (body == "") {
    return ".";
  }
  return body;
}

fn _joinComponents(components) {
  var out = "";
  var i = 0;
  while (i < len(components)) {
    if (i > 0) {
      out = out + _SEP;
    }
    out = out + components[i];
    i = i + 1;
  }
  return out;
}

// --- relative paths --------------------------------------------------------

// The relative path that reaches `to` from the directory `from`. Both sides are
// normalised first. When one side is absolute and the other is not, or when the
// two share no prefix at all, there is no relative path to compute and `to`
// (normalised) is returned unchanged.
//
//   relative("/a", "/a/b/c")   -> "b/c"
//   relative("/a/b", "/a/c")   -> "../c"
//   relative("/a", "/a")       -> "."
//   relative("a", "b")         -> "../b"
@MustUse
fn relative(from, to) {
  let start = normalize(from);
  let target = normalize(to);
  if (start == target) {
    return ".";
  }
  let startAbsolute = isAbsolute(start);
  if (startAbsolute != isAbsolute(target)) {
    return target;
  }
  let fromParts = split(start);
  let toParts = split(target);
  var i = startAbsolute ? 1 : 0;
  var j = startAbsolute ? 1 : 0;
  while (i < len(fromParts) && j < len(toParts) && fromParts[i] == toParts[j]) {
    i = i + 1;
    j = j + 1;
  }
  var steps = [];
  var up = i;
  while (up < len(fromParts)) {
    steps[len(steps)] = "..";
    up = up + 1;
  }
  var down = j;
  while (down < len(toParts)) {
    steps[len(steps)] = toParts[down];
    down = down + 1;
  }
  if (len(steps) == 0) {
    return ".";
  }
  return _joinComponents(steps);
}
