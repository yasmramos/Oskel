// In-memory text streams.
//
// File access stays with the `readFile`/`writeFile`/`fileExists` builtins: the
// AOT freestanding backend does not seed them, and a module that mentions one
// fails `oskel build` even when the function is never called. Everything here
// is plain Oskel over strings, so it runs on the VM, in a native binary and on
// WebAssembly.
//
// A `StringReader` walks a string by code point; a `StringWriter` accumulates
// text in chunks. Both are ordinary classes, so an instance is a map and the
// methods compose with the rest of the language.

// ASCII whitespace, the separator `readToken` uses.
fn _isSpace(c: string): bool {
  return c == " " || c == "\t" || c == "\n" || c == "\r";
}

// Drops one trailing `\r`, so a CRLF line has the same text as an LF one.
fn _stripCR(line: string): string {
  if (len(line) > 0 && line[len(line) - 1] == "\r") {
    return line[0:len(line) - 1];
  }
  return line;
}

// Splits text on `\n`, dropping one trailing `\r` from each line. A trailing
// newline does not produce an extra empty line, so `joinLines` round-trips
// text that has no trailing newline.
//
//   splitLines("a\r\nb\n") -> ["a", "b"]
//   splitLines("") -> []
//   splitLines("\n") -> [""]
@MustUse
fn splitLines(text: string): array {
  var out = [];
  var start = 0;
  var i = 0;
  while (i < len(text)) {
    if (text[i] == "\n") {
      out[len(out)] = _stripCR(text[start:i]);
      start = i + 1;
    }
    i = i + 1;
  }
  if (start < len(text)) {
    out[len(out)] = _stripCR(text[start:len(text)]);
  }
  return out;
}

// Joins lines with `\n` between them, without a trailing newline.
//
//   joinLines(["a", "b"]) -> "a\nb"
//   joinLines([]) -> ""
@MustUse
fn joinLines(lines: array): string {
  var out = "";
  var i = 0;
  while (i < len(lines)) {
    if (i > 0) {
      out = out + "\n";
    }
    out = out + lines[i];
    i = i + 1;
  }
  return out;
}

// A forward-only cursor over a string.
//
//   let r = StringReader("hello\nworld");
//   r.readLine()   // "hello"
//   r.readLine()   // "world"
//   r.eof()        // true
class StringReader {
  text: string;
  pos: int;

  fn init(text: string) {
    self.text = text;
    self.pos = 0;
  }

  // True when every code point has been consumed.
  fn eof(): bool {
    return self.pos >= len(self.text);
  }

  // The index of the next code point, in code points from the start.
  fn position(): int {
    return self.pos;
  }

  // How many code points are left.
  fn remaining(): int {
    return len(self.text) - self.pos;
  }

  // The unconsumed text, without advancing.
  fn rest(): string {
    return self.text[self.pos:len(self.text)];
  }

  // The next code point, or `""` at the end. Does not advance.
  fn peek(): string {
    if (self.eof()) {
      return "";
    }
    return self.text[self.pos];
  }

  // The next code point and advance, or `""` at the end.
  fn readChar(): string {
    let c = self.peek();
    if (c != "") {
      self.pos = self.pos + 1;
    }
    return c;
  }

  // Up to `count` code points. A non-positive count returns `""`.
  fn read(count: int): string {
    if (count <= 0) {
      return "";
    }
    let end = self.pos + count < len(self.text) ? self.pos + count : len(self.text);
    let out = self.text[self.pos:end];
    self.pos = end;
    return out;
  }

  // The next line, consuming its `\n` and dropping one trailing `\r`. Returns
  // `""` at the end; check `eof()` first to tell the two apart.
  fn readLine(): string {
    if (self.eof()) {
      return "";
    }
    let start = self.pos;
    while (self.pos < len(self.text) && self.text[self.pos] != "\n") {
      self.pos = self.pos + 1;
    }
    let line = self.text[start:self.pos];
    if (self.pos < len(self.text)) {
      self.pos = self.pos + 1;
    }
    return _stripCR(line);
  }

  // The rest of the text and advance to the end.
  fn readAll(): string {
    let out = self.rest();
    self.pos = len(self.text);
    return out;
  }

  // Advances up to `count` code points; returns how many it actually skipped.
  fn skip(count: int): int {
    if (count <= 0) {
      return 0;
    }
    let end = self.pos + count < len(self.text) ? self.pos + count : len(self.text);
    let skipped = end - self.pos;
    self.pos = end;
    return skipped;
  }

  // The run of code points for which `pred` is truthy, and advance past it.
  fn readWhile(pred): string {
    let start = self.pos;
    while (self.pos < len(self.text) && pred(self.text[self.pos])) {
      self.pos = self.pos + 1;
    }
    return self.text[start:self.pos];
  }

  // Skips the run of code points for which `pred` is truthy; returns its length.
  fn skipWhile(pred): int {
    let start = self.pos;
    while (self.pos < len(self.text) && pred(self.text[self.pos])) {
      self.pos = self.pos + 1;
    }
    return self.pos - start;
  }

  // Skips ASCII whitespace, then reads up to the next whitespace. `""` at the
  // end. `int(r.readToken())` parses a number.
  fn readToken(): string {
    self.skipWhile(c => _isSpace(c));
    return self.readWhile(c => !_isSpace(c));
  }

  // The remaining lines (see `splitLines`), consuming all of them.
  fn lines(): array {
    return splitLines(self.readAll());
  }
}

// Concatenates `chunks[lo:hi]` with a balanced tree, so `k` chunks cost
// O(total * log k) instead of O(total * k) when the prefix is copied per write.
fn _concatRange(chunks: array, lo: int, hi: int): string {
  if (hi - lo == 1) {
    return chunks[lo];
  }
  let mid = lo + (hi - lo) / 2;
  return _concatRange(chunks, lo, mid) + _concatRange(chunks, mid, hi);
}

// A growable text buffer. Writes never re-scan the accumulated text; `toString`
// concatenates the chunks with a balanced tree.
//
//   let w = StringWriter();
//   w.write("a").writeln("b");
//   w.toString()   // "a\nb\n"
class StringWriter {
  chunks: array;
  count: int;

  fn init() {
    self.chunks = [];
    self.count = 0;
  }

  // Appends `s`; returns `self` for chaining.
  fn write(s: string) {
    self.chunks[len(self.chunks)] = s;
    self.count = self.count + len(s);
    return self;
  }

  // Appends `s` followed by a newline; returns `self`.
  fn writeln(s: string) {
    self.write(s);
    self.write("\n");
    return self;
  }

  // Appends every element of `xs`; returns `self`.
  fn writeAll(xs: array) {
    for x in xs {
      self.write(x);
    }
    return self;
  }

  // Appends every element of `xs` followed by a newline; returns `self`.
  fn writeLines(xs: array) {
    for x in xs {
      self.writeln(x);
    }
    return self;
  }

  // The number of code points written so far.
  fn size(): int {
    return self.count;
  }

  // True when nothing has been written.
  fn isEmpty(): bool {
    return self.count == 0;
  }

  // The accumulated text.
  fn toString(): string {
    if (len(self.chunks) == 0) {
      return "";
    }
    return _concatRange(self.chunks, 0, len(self.chunks));
  }

  // Discards everything; returns `self`.
  fn clear() {
    self.chunks = [];
    self.count = 0;
    return self;
  }
}
