// Standard library: bytes and binary codecs.
//
// Imported as `import std.bytes;` (qualified: `std.bytes.hexEncode`),
// `import std.bytes.*;` (unqualified: `hexEncode`), `import std.bytes as b;`
// or `import { hexEncode, base64Decode } from std.bytes;`.
//
// A byte is an `int` in `0..255`; a byte string is an array of bytes. Keeping
// the representation an ordinary array means every collection helper composes
// with it, and the module needs no new runtime type. `fromString`/`toString`
// convert through UTF-8, `hexEncode`/`hexDecode` and the Base64 pair are the
// text encodings, and `readU16LE`/`writeU32BE`/... are the fixed-width binary
// codecs a file format or a network frame needs.
//
// The module is pure Oskel over the portable primitive surface (indexing,
// slicing, `len`, `ord`/`chr`, `str`, `type`, `panic`, `for ... in`,
// closures), so it behaves identically on the development VM, under
// `oskel build` and on WebAssembly. Every public function validates its byte
// array and raises a runtime error on a value outside `0..255`; `isValid`
// checks without raising.
//
// Base64 uses the RFC 4648 standard alphabet with `=` padding. The URL-safe
// pair uses `-` and `_` and omits the padding, while the decoder accepts both
// padded and unpadded input in either alphabet.

// --- validation -------------------------------------------------------------

// True when `value` is an integer in the byte range.
@MustUse
fn _isByte(value) {
  return type(value) == "int" && value >= 0 && value <= 255;
}

// True when every item is a byte. A non-array value is not a byte string.
@MustUse
fn isValid(bytes) {
  if (type(bytes) != "array") {
    return false;
  }
  for value in bytes {
    if (!_isByte(value)) {
      return false;
    }
  }
  return true;
}

// Raises unless every item is a byte.
fn _checkBytes(bytes) {
  if (!isValid(bytes)) {
    panic("std.bytes: expected an array of bytes (integers in 0..255)");
  }
}

// Raises unless `[offset, offset + size)` lies inside `bytes`.
fn _checkRange(bytes, offset, size) {
  if (offset < 0 || size < 0 || offset + size > len(bytes)) {
    panic("std.bytes: byte range " + str(offset) + ".." + str(offset + size)
      + " is outside a " + str(len(bytes)) + "-byte array");
  }
}

// --- UTF-8 ------------------------------------------------------------------

// The UTF-8 encoding of one Unicode code point, as an array of one to four
// bytes.
@MustUse
fn _utf8Bytes(code) {
  if (code < 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF)) {
    panic("std.bytes: invalid Unicode code point " + str(code));
  }
  if (code <= 0x7F) {
    return [code];
  }
  if (code <= 0x7FF) {
    return [0xC0 | (code >> 6), 0x80 | (code & 0x3F)];
  }
  if (code <= 0xFFFF) {
    return [0xE0 | (code >> 12), 0x80 | ((code >> 6) & 0x3F), 0x80 | (code & 0x3F)];
  }
  return [
    0xF0 | (code >> 18),
    0x80 | ((code >> 12) & 0x3F),
    0x80 | ((code >> 6) & 0x3F),
    0x80 | (code & 0x3F)
  ];
}

// The number of UTF-8 bytes a code point occupies.
@MustUse
fn _utf8Length(code) {
  if (code <= 0x7F) {
    return 1;
  }
  if (code <= 0x7FF) {
    return 2;
  }
  if (code <= 0xFFFF) {
    return 3;
  }
  return 4;
}

// True for a UTF-8 continuation byte (`10xxxxxx`).
@MustUse
fn _isContinuation(value) {
  return (value & 0xC0) == 0x80;
}

// The UTF-8 bytes of a string.
//
//   fromString("hé") -> [104, 195, 169]
@MustUse
fn fromString(s) {
  var out = [];
  for ch in s {
    for value in _utf8Bytes(ord(ch)) {
      out[len(out)] = value;
    }
  }
  return out;
}

// The number of UTF-8 bytes a string occupies.
//
//   byteLength("hé") -> 3
@MustUse
fn byteLength(s) {
  var total = 0;
  for ch in s {
    total = total + _utf8Length(ord(ch));
  }
  return total;
}

// Decodes UTF-8 bytes to a string. Raises on a truncated sequence, an
// overlong form, a surrogate or a code point above `0x10FFFF`.
//
//   toString([104, 195, 169]) -> "hé"
@MustUse
fn toString(bytes) {
  _checkBytes(bytes);
  var out = "";
  var i = 0;
  while (i < len(bytes)) {
    let first = bytes[i];
    var code = 0;
    if (first < 0x80) {
      code = first;
      i = i + 1;
    } else if (first >= 0xC2 && first <= 0xDF) {
      if (i + 1 >= len(bytes) || !_isContinuation(bytes[i + 1])) {
        panic("std.bytes.toString: truncated UTF-8 at byte " + str(i));
      }
      code = ((first & 0x1F) << 6) | (bytes[i + 1] & 0x3F);
      i = i + 2;
    } else if (first >= 0xE0 && first <= 0xEF) {
      if (i + 2 >= len(bytes)
          || !_isContinuation(bytes[i + 1])
          || !_isContinuation(bytes[i + 2])) {
        panic("std.bytes.toString: truncated UTF-8 at byte " + str(i));
      }
      code = ((first & 0x0F) << 12)
        | ((bytes[i + 1] & 0x3F) << 6)
        | (bytes[i + 2] & 0x3F);
      if (code < 0x800) {
        panic("std.bytes.toString: overlong UTF-8 at byte " + str(i));
      }
      if (code >= 0xD800 && code <= 0xDFFF) {
        panic("std.bytes.toString: UTF-8 encodes a surrogate at byte " + str(i));
      }
      i = i + 3;
    } else if (first >= 0xF0 && first <= 0xF4) {
      if (i + 3 >= len(bytes)
          || !_isContinuation(bytes[i + 1])
          || !_isContinuation(bytes[i + 2])
          || !_isContinuation(bytes[i + 3])) {
        panic("std.bytes.toString: truncated UTF-8 at byte " + str(i));
      }
      code = ((first & 0x07) << 18)
        | ((bytes[i + 1] & 0x3F) << 12)
        | ((bytes[i + 2] & 0x3F) << 6)
        | (bytes[i + 3] & 0x3F);
      if (code < 0x10000 || code > 0x10FFFF) {
        panic("std.bytes.toString: invalid UTF-8 code point at byte " + str(i));
      }
      i = i + 4;
    } else {
      panic("std.bytes.toString: invalid UTF-8 byte at offset " + str(i));
    }
    out = out + chr(code);
  }
  return out;
}

// --- hexadecimal ------------------------------------------------------------

@MustUse
fn _hexDigit(value) {
  return value < 10 ? chr(48 + value) : chr(87 + value);
}

@MustUse
fn _hexValue(c) {
  let code = ord(c);
  if (code >= 48 && code <= 57) {
    return code - 48;
  }
  if (code >= 65 && code <= 70) {
    return code - 55;
  }
  if (code >= 97 && code <= 102) {
    return code - 87;
  }
  return -1;
}

// Lowercase hexadecimal for a byte array.
//
//   hexEncode([0, 15, 255]) -> "000fff"
@MustUse
fn hexEncode(bytes) {
  _checkBytes(bytes);
  var out = "";
  for value in bytes {
    out = out + _hexDigit(value >> 4) + _hexDigit(value & 0x0F);
  }
  return out;
}

// Decodes hexadecimal, accepting either case. Raises on an odd length or a
// non-hexadecimal character.
//
//   hexDecode("000fff") -> [0, 15, 255]
@MustUse
fn hexDecode(text) {
  if (len(text) % 2 != 0) {
    panic("std.bytes.hexDecode: expected an even number of digits");
  }
  var out = [];
  var i = 0;
  while (i < len(text)) {
    let high = _hexValue(text[i]);
    let low = _hexValue(text[i + 1]);
    if (high < 0 || low < 0) {
      panic("std.bytes.hexDecode: invalid hexadecimal digit at position " + str(i));
    }
    out[len(out)] = high * 16 + low;
    i = i + 2;
  }
  return out;
}

// --- Base64 -----------------------------------------------------------------

const _B64_STANDARD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const _B64_URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

@MustUse
fn _b64Value(c, urlSafe) {
  let code = ord(c);
  if (code >= 65 && code <= 90) {
    return code - 65;
  }
  if (code >= 97 && code <= 122) {
    return code - 71;
  }
  if (code >= 48 && code <= 57) {
    return code + 4;
  }
  if (c == "+" || (urlSafe && c == "-")) {
    return 62;
  }
  if (c == "/" || (urlSafe && c == "_")) {
    return 63;
  }
  return -1;
}

@MustUse
fn _base64Encode(bytes, alphabet, padded) {
  _checkBytes(bytes);
  var out = "";
  var i = 0;
  while (i + 2 < len(bytes)) {
    let a = bytes[i];
    let b = bytes[i + 1];
    let c = bytes[i + 2];
    out = out + alphabet[a >> 2]
      + alphabet[((a & 0x03) << 4) | (b >> 4)]
      + alphabet[((b & 0x0F) << 2) | (c >> 6)]
      + alphabet[c & 0x3F];
    i = i + 3;
  }
  let remaining = len(bytes) - i;
  if (remaining == 1) {
    let a = bytes[i];
    out = out + alphabet[a >> 2] + alphabet[(a & 0x03) << 4];
    if (padded) {
      out = out + "==";
    }
  } else if (remaining == 2) {
    let a = bytes[i];
    let b = bytes[i + 1];
    out = out + alphabet[a >> 2]
      + alphabet[((a & 0x03) << 4) | (b >> 4)]
      + alphabet[(b & 0x0F) << 2];
    if (padded) {
      out = out + "=";
    }
  }
  return out;
}

// Standard Base64 with `=` padding.
//
//   base64Encode(fromString("foobar")) -> "Zm9vYmFy"
@MustUse
fn base64Encode(bytes) {
  return _base64Encode(bytes, _B64_STANDARD, true);
}

// URL-safe Base64 without padding, as used in URLs and JWT segments.
@MustUse
fn base64UrlEncode(bytes) {
  return _base64Encode(bytes, _B64_URL, false);
}

@MustUse
fn _base64Decode(text, urlSafe) {
  var clean = "";
  var padding = 0;
  var sawPadding = false;
  for c in text {
    if (c == "=") {
      sawPadding = true;
      padding = padding + 1;
    } else {
      if (sawPadding) {
        panic("std.bytes.base64Decode: padding must be at the end");
      }
      if (_b64Value(c, urlSafe) < 0) {
        panic("std.bytes.base64Decode: invalid Base64 character '" + c + "'");
      }
      clean = clean + c;
    }
  }
  if (padding > 2) {
    panic("std.bytes.base64Decode: too much padding");
  }
  if (padding > 0 && (len(clean) + padding) % 4 != 0) {
    panic("std.bytes.base64Decode: invalid padding");
  }
  if (len(clean) % 4 == 1) {
    panic("std.bytes.base64Decode: invalid Base64 length");
  }

  var out = [];
  var i = 0;
  while (i + 4 <= len(clean)) {
    let a = _b64Value(clean[i], urlSafe);
    let b = _b64Value(clean[i + 1], urlSafe);
    let c = _b64Value(clean[i + 2], urlSafe);
    let d = _b64Value(clean[i + 3], urlSafe);
    out[len(out)] = (a << 2) | (b >> 4);
    out[len(out)] = ((b & 0x0F) << 4) | (c >> 2);
    out[len(out)] = ((c & 0x03) << 6) | d;
    i = i + 4;
  }
  let remaining = len(clean) - i;
  if (remaining == 2) {
    let a = _b64Value(clean[i], urlSafe);
    let b = _b64Value(clean[i + 1], urlSafe);
    out[len(out)] = (a << 2) | (b >> 4);
  } else if (remaining == 3) {
    let a = _b64Value(clean[i], urlSafe);
    let b = _b64Value(clean[i + 1], urlSafe);
    let c = _b64Value(clean[i + 2], urlSafe);
    out[len(out)] = (a << 2) | (b >> 4);
    out[len(out)] = ((b & 0x0F) << 4) | (c >> 2);
  }
  return out;
}

// Decodes standard Base64. Padded and unpadded input are both accepted.
@MustUse
fn base64Decode(text) {
  return _base64Decode(text, false);
}

// Decodes URL-safe Base64, accepting optional padding.
@MustUse
fn base64UrlDecode(text) {
  return _base64Decode(text, true);
}

// --- fixed-width integers ---------------------------------------------------

// Reads one unsigned byte.
@MustUse
fn readU8(bytes, offset) {
  _checkBytes(bytes);
  _checkRange(bytes, offset, 1);
  return bytes[offset];
}

// Reads one signed byte.
@MustUse
fn readI8(bytes, offset) {
  let value = readU8(bytes, offset);
  return value >= 0x80 ? value - 0x100 : value;
}

// Reads a little-endian unsigned 16-bit integer.
@MustUse
fn readU16LE(bytes, offset) {
  _checkBytes(bytes);
  _checkRange(bytes, offset, 2);
  return bytes[offset] + bytes[offset + 1] * 0x100;
}

// Reads a big-endian unsigned 16-bit integer.
@MustUse
fn readU16BE(bytes, offset) {
  _checkBytes(bytes);
  _checkRange(bytes, offset, 2);
  return bytes[offset] * 0x100 + bytes[offset + 1];
}

// Reads a little-endian signed 16-bit integer.
@MustUse
fn readI16LE(bytes, offset) {
  let value = readU16LE(bytes, offset);
  return value >= 0x8000 ? value - 0x10000 : value;
}

// Reads a big-endian signed 16-bit integer.
@MustUse
fn readI16BE(bytes, offset) {
  let value = readU16BE(bytes, offset);
  return value >= 0x8000 ? value - 0x10000 : value;
}

// Reads a little-endian unsigned 32-bit integer.
@MustUse
fn readU32LE(bytes, offset) {
  _checkBytes(bytes);
  _checkRange(bytes, offset, 4);
  return bytes[offset]
    + bytes[offset + 1] * 0x100
    + bytes[offset + 2] * 0x10000
    + bytes[offset + 3] * 0x1000000;
}

// Reads a big-endian unsigned 32-bit integer.
@MustUse
fn readU32BE(bytes, offset) {
  _checkBytes(bytes);
  _checkRange(bytes, offset, 4);
  return bytes[offset] * 0x1000000
    + bytes[offset + 1] * 0x10000
    + bytes[offset + 2] * 0x100
    + bytes[offset + 3];
}

// Reads a little-endian signed 32-bit integer.
@MustUse
fn readI32LE(bytes, offset) {
  let value = readU32LE(bytes, offset);
  return value >= 0x80000000 ? value - 0x100000000 : value;
}

// Reads a big-endian signed 32-bit integer.
@MustUse
fn readI32BE(bytes, offset) {
  let value = readU32BE(bytes, offset);
  return value >= 0x80000000 ? value - 0x100000000 : value;
}

// Encodes an unsigned byte.
@MustUse
fn writeU8(value) {
  if (value < 0 || value > 0xFF) {
    panic("std.bytes.writeU8: value must be in 0..255");
  }
  return [value];
}

// Encodes a signed byte.
@MustUse
fn writeI8(value) {
  if (value < -0x80 || value > 0x7F) {
    panic("std.bytes.writeI8: value must be in -128..127");
  }
  return [value < 0 ? value + 0x100 : value];
}

// Encodes a little-endian unsigned 16-bit integer.
@MustUse
fn writeU16LE(value) {
  if (value < 0 || value > 0xFFFF) {
    panic("std.bytes.writeU16LE: value must be in 0..65535");
  }
  return [value & 0xFF, (value >> 8) & 0xFF];
}

// Encodes a big-endian unsigned 16-bit integer.
@MustUse
fn writeU16BE(value) {
  if (value < 0 || value > 0xFFFF) {
    panic("std.bytes.writeU16BE: value must be in 0..65535");
  }
  return [(value >> 8) & 0xFF, value & 0xFF];
}

// Encodes a little-endian signed 16-bit integer.
@MustUse
fn writeI16LE(value) {
  if (value < -0x8000 || value > 0x7FFF) {
    panic("std.bytes.writeI16LE: value must be in -32768..32767");
  }
  return writeU16LE(value < 0 ? value + 0x10000 : value);
}

// Encodes a big-endian signed 16-bit integer.
@MustUse
fn writeI16BE(value) {
  if (value < -0x8000 || value > 0x7FFF) {
    panic("std.bytes.writeI16BE: value must be in -32768..32767");
  }
  return writeU16BE(value < 0 ? value + 0x10000 : value);
}

// Encodes a little-endian unsigned 32-bit integer.
@MustUse
fn writeU32LE(value) {
  if (value < 0 || value > 0xFFFFFFFF) {
    panic("std.bytes.writeU32LE: value must be in 0..4294967295");
  }
  return [
    value & 0xFF,
    (value >> 8) & 0xFF,
    (value >> 16) & 0xFF,
    (value >> 24) & 0xFF
  ];
}

// Encodes a big-endian unsigned 32-bit integer.
@MustUse
fn writeU32BE(value) {
  if (value < 0 || value > 0xFFFFFFFF) {
    panic("std.bytes.writeU32BE: value must be in 0..4294967295");
  }
  return [
    (value >> 24) & 0xFF,
    (value >> 16) & 0xFF,
    (value >> 8) & 0xFF,
    value & 0xFF
  ];
}

// Encodes a little-endian signed 32-bit integer.
@MustUse
fn writeI32LE(value) {
  if (value < -0x80000000 || value > 0x7FFFFFFF) {
    panic("std.bytes.writeI32LE: value must be in -2147483648..2147483647");
  }
  return writeU32LE(value < 0 ? value + 0x100000000 : value);
}

// Encodes a big-endian signed 32-bit integer.
@MustUse
fn writeI32BE(value) {
  if (value < -0x80000000 || value > 0x7FFFFFFF) {
    panic("std.bytes.writeI32BE: value must be in -2147483648..2147483647");
  }
  return writeU32BE(value < 0 ? value + 0x100000000 : value);
}

// --- array helpers ----------------------------------------------------------

// A new array with `left` followed by `right`.
@MustUse
fn concat(left, right) {
  _checkBytes(left);
  _checkBytes(right);
  var out = [];
  for value in left {
    out[len(out)] = value;
  }
  for value in right {
    out[len(out)] = value;
  }
  return out;
}

// The bytes in `[start, end)`.
@MustUse
fn slice(bytes, start, end) {
  _checkBytes(bytes);
  if (start < 0 || end < start || end > len(bytes)) {
    panic("std.bytes.slice: invalid range " + str(start) + ".." + str(end));
  }
  var out = [];
  var i = start;
  while (i < end) {
    out[len(out)] = bytes[i];
    i = i + 1;
  }
  return out;
}

// The first index of `needle` in `bytes`, or `-1`. An empty needle is at 0.
@MustUse
fn indexOf(bytes, needle) {
  _checkBytes(bytes);
  _checkBytes(needle);
  if (len(needle) == 0) {
    return 0;
  }
  if (len(needle) > len(bytes)) {
    return -1;
  }
  var i = 0;
  while (i + len(needle) <= len(bytes)) {
    var j = 0;
    var matches = true;
    while (j < len(needle)) {
      if (bytes[i + j] != needle[j]) {
        matches = false;
        break;
      }
      j = j + 1;
    }
    if (matches) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// True when `needle` occurs in `bytes`. The empty needle occurs everywhere.
@MustUse
fn contains(bytes, needle) {
  return indexOf(bytes, needle) >= 0;
}

// True when `bytes` starts with `prefix`.
@MustUse
fn startsWith(bytes, prefix) {
  _checkBytes(bytes);
  _checkBytes(prefix);
  if (len(prefix) > len(bytes)) {
    return false;
  }
  return slice(bytes, 0, len(prefix)) == prefix;
}

// True when `bytes` ends with `suffix`.
@MustUse
fn endsWith(bytes, suffix) {
  _checkBytes(bytes);
  _checkBytes(suffix);
  if (len(suffix) > len(bytes)) {
    return false;
  }
  return slice(bytes, len(bytes) - len(suffix), len(bytes)) == suffix;
}

// True when both arrays hold the same bytes.
@MustUse
fn equals(left, right) {
  _checkBytes(left);
  _checkBytes(right);
  if (len(left) != len(right)) {
    return false;
  }
  var i = 0;
  while (i < len(left)) {
    if (left[i] != right[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// Lexicographic comparison: `-1`, `0` or `1`.
@MustUse
fn compare(left, right) {
  _checkBytes(left);
  _checkBytes(right);
  var i = 0;
  while (i < len(left) && i < len(right)) {
    if (left[i] < right[i]) {
      return -1;
    }
    if (left[i] > right[i]) {
      return 1;
    }
    i = i + 1;
  }
  if (len(left) < len(right)) {
    return -1;
  }
  if (len(left) > len(right)) {
    return 1;
  }
  return 0;
}

// A new array with the bytes in reverse order.
@MustUse
fn reversed(bytes) {
  _checkBytes(bytes);
  var out = [];
  var i = len(bytes) - 1;
  while (i >= 0) {
    out[len(out)] = bytes[i];
    i = i - 1;
  }
  return out;
}

// `bytes` repeated `count` times.
@MustUse
fn repeat(bytes, count) {
  _checkBytes(bytes);
  if (count < 0) {
    panic("std.bytes.repeat: count must not be negative");
  }
  var out = [];
  var n = 0;
  while (n < count) {
    for value in bytes {
      out[len(out)] = value;
    }
    n = n + 1;
  }
  return out;
}

// True when every byte is below `0x80`.
@MustUse
fn isAscii(bytes) {
  _checkBytes(bytes);
  for value in bytes {
    if (value >= 0x80) {
      return false;
    }
  }
  return true;
}
