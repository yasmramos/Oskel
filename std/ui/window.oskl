// Public: run a `std.ui` tree in an SDL3 window, rendered by Skia.
//
// Import it with an alias so `ui.Window(...)` and the other widget classes
// stay qualified:
//
//   import std.ui as ui;
//   import std.ui.window as ui_window;
//
//   let root = ui.Window("Demo", 320, 200,
//     ui.Column(8, [ui.Text("Hello", 24)]));
//   ui_window.run("Demo", root, 320, 200, 0);
//
// `run` returns the number of frames it presented. A `maxFrames` of zero or
// less runs until the window is closed or Escape is pressed; a positive value
// bounds the loop for a headless test. The SDL and Skia modules are internal
// details of this entry point.

import std.internal.skia_window as backend;

fn run(title, root, width, height, maxFrames): int {
  return backend.run(title, root, width, height, maxFrames);
}

fn click(root, x, y): bool {
  return backend.click(root, x, y);
}
