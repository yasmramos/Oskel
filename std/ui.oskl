// Standard library: declarative widgets and a headless layout.
//
// Imported as `import std.ui as ui;` (qualified: `ui.column`), as
// `import std.ui.*;`, or with a selective import.
//
// The module is pure Oskel over the portable primitive surface (maps, arrays,
// indexing, `len`, `int`, `for ... in`, closures and the operators), so a
// widget tree behaves identically on the development VM and under
// `oskel build`. It produces a display list; a backend (Skia, SDL, a test)
// consumes the list. The module never calls a window or graphics API itself.
//
//   import std.ui as ui;
//
//   let root = ui.window("Demo", 320, 200,
//     ui.column(8, [
//       ui.text("Hello", 24),
//       ui.button("OK", () => print("clicked")),
//     ]));
//   ui.layout(root, 320, 200);
//   for cmd in ui.commands(root) {
//     // cmd.kind is "rect" or "text"; a backend draws it.
//   }
//
// A widget is a map with a `kind`, a frame (`x`, `y`, `w`, `h`) and the fields
// its kind needs. `layout` mutates the tree and attaches the frame; `commands`
// reads the frames and returns new maps, so drawing never mutates the tree.
//
// Layout is deliberately small: a column stacks its children, a row places
// them side by side, and padding insets one child. `layout` measures text with
// a fixed 0.6 advance per character and a 1.4 line height, which keeps a
// headless layout deterministic. A renderer that owns a real font passes its
// own measurer to `layoutWith`; the tree itself never calls a graphics API.

// --- constructors -----------------------------------------------------------

// A top-level window. `child` is usually a column or a row.
@MustUse
fn window(title, width, height, child) {
  return {
    kind: "window",
    title: title,
    width: width,
    height: height,
    child: child,
    background: 0xFFFFFFFF,
    x: 0,
    y: 0,
    w: 0,
    h: 0,
  };
}

// A vertical stack. `gap` is the space between two children.
@MustUse
fn column(gap, children) {
  return { kind: "column", gap: gap, children: children, x: 0, y: 0, w: 0, h: 0 };
}

// A horizontal stack. `gap` is the space between two children.
@MustUse
fn row(gap, children) {
  return { kind: "row", gap: gap, children: children, x: 0, y: 0, w: 0, h: 0 };
}

// Insets one child by `all` pixels on every side.
@MustUse
fn padding(all, child) {
  return { kind: "padding", all: all, child: child, x: 0, y: 0, w: 0, h: 0 };
}

// Empty vertical space.
@MustUse
fn spacer(height) {
  return { kind: "spacer", height: height, x: 0, y: 0, w: 0, h: 0 };
}

// Black text at `size`.
@MustUse
fn text(content, size) {
  return textColor(content, size, 0xFF000000);
}

// Text with an explicit ARGB colour.
@MustUse
fn textColor(content, size, color) {
  return {
    kind: "text",
    content: content,
    size: size,
    color: color,
    x: 0,
    y: 0,
    w: 0,
    h: 0,
  };
}

// A blue button with white text and distinct hover/pressed shades.
@MustUse
fn button(label, onClick) {
  return buttonStates(label, onClick, 0xFF2563EB, 0xFF1D4ED8, 0xFF1E40AF,
                      0xFFFFFFFF);
}

// A button with an explicit background and text colour. The hover and pressed
// states keep the same background; use `buttonStates` when they must differ.
@MustUse
fn buttonStyle(label, onClick, background, color) {
  return buttonStates(label, onClick, background, background, background, color);
}

// A button with an explicit background for each pointer state.
@MustUse
fn buttonStates(label, onClick, background, hoverBackground, pressedBackground,
                color) {
  return {
    kind: "button",
    label: label,
    onClick: onClick,
    size: 14,
    background: background,
    hoverBackground: hoverBackground,
    pressedBackground: pressedBackground,
    color: color,
    hover: false,
    pressed: false,
    x: 0,
    y: 0,
    w: 0,
    h: 0,
  };
}

// --- measurement ------------------------------------------------------------

fn _max(a, b) {
  if (a > b) {
    return a;
  }
  return b;
}

// The default advance used when no renderer supplies a font metric.
fn _fixedAdvance(text, size): int {
  return int(len(text) * size * 0.6);
}

// The intrinsic size of `node` as `[width, height]`.
fn _measure(node, maxWidth, measure) {
  if (node.kind == "window") {
    return [node.width, node.height];
  }
  if (node.kind == "text") {
    return [measure(node.content, node.size), int(node.size * 1.4)];
  }
  if (node.kind == "button") {
    return [measure(node.label, node.size) + 24, int(node.size * 1.4) + 16];
  }
  if (node.kind == "spacer") {
    return [0, node.height];
  }
  if (node.kind == "padding") {
    let inner = _measure(node.child, maxWidth, measure);
    return [inner[0] + node.all * 2, inner[1] + node.all * 2];
  }
  if (node.kind == "column") {
    var width = 0;
    var height = 0;
    var first = true;
    for child in node.children {
      let size = _measure(child, maxWidth, measure);
      width = _max(width, size[0]);
      if (first) {
        height = size[1];
        first = false;
      } else {
        height = height + node.gap + size[1];
      }
    }
    return [width, height];
  }
  if (node.kind == "row") {
    var width = 0;
    var height = 0;
    var first = true;
    for child in node.children {
      let size = _measure(child, maxWidth, measure);
      if (first) {
        width = size[0];
        first = false;
      } else {
        width = width + node.gap + size[0];
      }
      height = _max(height, size[1]);
    }
    return [width, height];
  }
  return [0, 0];
}

// --- placement --------------------------------------------------------------

fn _place(node, x, y, width, height, measure) {
  node.x = x;
  node.y = y;
  node.w = width;
  node.h = height;

  if (node.kind == "window") {
    _place(node.child, x, y, width, height, measure);
  } else if (node.kind == "padding") {
    _place(node.child, x + node.all, y + node.all, width - node.all * 2,
           height - node.all * 2, measure);
  } else if (node.kind == "column") {
    var cursor = y;
    for child in node.children {
      let size = _measure(child, width, measure);
      _place(child, x, cursor, width, size[1], measure);
      cursor = cursor + size[1] + node.gap;
    }
  } else if (node.kind == "row") {
    var cursor = x;
    for child in node.children {
      let size = _measure(child, width, measure);
      _place(child, cursor, y, size[0], height, measure);
      cursor = cursor + size[0] + node.gap;
    }
  }
  return node;
}

// Measures and places the tree with the default fixed advance.
fn layout(root, width, height) {
  return layoutWith(root, width, height, _fixedAdvance);
}

// Measures and places the tree with a renderer-supplied `measure(text, size)`
// that returns the advance width in pixels. A window uses its own size; any
// other root uses the viewport passed here.
fn layoutWith(root, width, height, measure) {
  if (root.kind == "window") {
    return _place(root, 0, 0, root.width, root.height, measure);
  }
  return _place(root, 0, 0, width, height, measure);
}

// --- display list -----------------------------------------------------------

fn _push(out, kind, x, y, w, h, color, content, size) {
  out[len(out)] = {
    kind: kind,
    x: x,
    y: y,
    w: w,
    h: h,
    color: color,
    text: content,
    size: size,
  };
}

fn _collect(node, out) {
  if (node.kind == "window") {
    _push(out, "rect", node.x, node.y, node.w, node.h, node.background, "", 0);
    _collect(node.child, out);
  } else if (node.kind == "padding") {
    _collect(node.child, out);
  } else if (node.kind == "column" || node.kind == "row") {
    for child in node.children {
      _collect(child, out);
    }
  } else if (node.kind == "text") {
    _push(out, "text", node.x, node.y + node.size, node.w, node.h, node.color,
          node.content, node.size);
  } else if (node.kind == "button") {
    var fill = node.background;
    if (node.pressed) {
      fill = node.pressedBackground;
    } else if (node.hover) {
      fill = node.hoverBackground;
    }
    _push(out, "rect", node.x, node.y, node.w, node.h, fill, "", 0);
    _push(out, "text", node.x + 12, node.y + int((node.h + node.size) / 2),
          node.w - 24, node.size, node.color, node.label, node.size);
  }
}

// The draw commands for a laid-out tree, in paint order.
@MustUse
fn commands(root) {
  var out = [];
  _collect(root, out);
  return out;
}

// --- hit testing ------------------------------------------------------------

fn _contains(node, x, y) {
  return x >= node.x && x < node.x + node.w && y >= node.y && y < node.y + node.h;
}

// The deepest button under `(x, y)`, or nil.
@MustUse
fn hitTest(node, x, y) {
  if (!_contains(node, x, y)) {
    return nil;
  }
  if (node.kind == "button") {
    return node;
  }
  if (node.kind == "window" || node.kind == "padding") {
    return hitTest(node.child, x, y);
  }
  if (node.kind == "column" || node.kind == "row") {
    for child in node.children {
      let hit = hitTest(child, x, y);
      if (hit != nil) {
        return hit;
      }
    }
  }
  return nil;
}

// --- pointer state ----------------------------------------------------------

fn _setHover(node, x, y): bool {
  var changed = false;
  if (node.kind == "button") {
    let next = _contains(node, x, y);
    if (node.hover != next) {
      node.hover = next;
      changed = true;
    }
  } else if (node.kind == "window" || node.kind == "padding") {
    changed = _setHover(node.child, x, y);
  } else if (node.kind == "column" || node.kind == "row") {
    for child in node.children {
      if (_setHover(child, x, y)) {
        changed = true;
      }
    }
  }
  return changed;
}

fn _setPressed(node, x, y): bool {
  var changed = false;
  if (node.kind == "button") {
    let next = _contains(node, x, y);
    if (node.pressed != next) {
      node.pressed = next;
      changed = true;
    }
  } else if (node.kind == "window" || node.kind == "padding") {
    changed = _setPressed(node.child, x, y);
  } else if (node.kind == "column" || node.kind == "row") {
    for child in node.children {
      if (_setPressed(child, x, y)) {
        changed = true;
      }
    }
  }
  return changed;
}

fn _clearPressed(node): bool {
  var changed = false;
  if (node.kind == "button") {
    if (node.pressed) {
      node.pressed = false;
      changed = true;
    }
  } else if (node.kind == "window" || node.kind == "padding") {
    changed = _clearPressed(node.child);
  } else if (node.kind == "column" || node.kind == "row") {
    for child in node.children {
      if (_clearPressed(child)) {
        changed = true;
      }
    }
  }
  return changed;
}

// Updates the hovered button under `(x, y)`. Returns whether a button changed
// state, so a caller can decide to redraw.
@MustUse
fn pointerMove(root, x, y): bool {
  return _setHover(root, x, y);
}

// Marks the button under `(x, y)` as pressed and clears every other button.
@MustUse
fn pointerDown(root, x, y): bool {
  let hovered = _setHover(root, x, y);
  let pressed = _setPressed(root, x, y);
  return hovered || pressed;
}

// Clears hover and pressed when the pointer leaves the window or the window
// loses focus, so no button keeps a stale highlight.
@MustUse
fn pointerCancel(root): bool {
  let hovered = _setHover(root, -1, -1);
  let pressed = _clearPressed(root);
  return hovered || pressed;
}

// Releases the pointer. The handler runs only when the press and the release
// land on the same button; the pressed state is always cleared.
@MustUse
fn pointerUp(root, x, y): bool {
  _setHover(root, x, y);
  let hit = hitTest(root, x, y);
  var pressed = false;
  if (hit != nil && hit.pressed) {
    pressed = true;
  }
  _clearPressed(root);
  if (!pressed) {
    return false;
  }
  let handler = hit.onClick;
  handler();
  return true;
}

// A complete press/release at one point, for headless callers. Returns whether
// the button's handler ran.
@MustUse
fn click(root, x, y): bool {
  _ = pointerDown(root, x, y);
  return pointerUp(root, x, y);
}
