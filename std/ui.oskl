// Standard library: declarative widgets and a headless layout.
//
// Imported as `import std.ui as ui;` (qualified: `ui.Column`), as
// `import std.ui.*;`, or with a selective import.
//
// The module is pure Oskel over the portable primitive surface (classes,
// arrays, maps, indexing, `len`, `int`, `for ... in`, closures and the
// operators), so a widget tree behaves identically on the development VM and
// under `oskel build`. It produces a display list; a backend (Skia, SDL, a
// test) consumes the list. The module never calls a window or graphics API
// itself.
//
//   import std.ui as ui;
//
//   let root = ui.Window("Demo", 320, 200,
//     ui.Column(8, [
//       ui.Text("Hello", 24),
//       ui.Button("OK", () => print("clicked")),
//       ui.Checkbox("Accept", false, (checked) => print(checked)),
//     ]));
//   ui.layout(root, 320, 200);
//   for cmd in ui.commands(root) {
//     // cmd.kind is "rect" or "text"; a backend draws it.
//   }
//
// A widget is an instance of a class implementing `Widget`. Each class owns
// its measurement, placement, display-list emission, hit testing and pointer
// state; `layout` and `commands` are thin entry points. Oskel erases classes
// to maps with a method table, so the VM and the AOT backend run the same code.
//
// Layout is deliberately small: a column stacks its children, a row places
// them side by side, and padding insets one child. `layout` measures text with
// a fixed 0.6 advance per character and a 1.4 line height, which keeps a
// headless layout deterministic. A renderer that owns a real font passes its
// own measurer to `layoutWith`; the tree itself never calls a graphics API.

// --- contracts --------------------------------------------------------------

interface Widget {
  fn measure(maxWidth: int, measure: function): array;
  fn place(x: int, y: int, w: int, h: int, measure: function);
  fn collect(out: array);
  fn hitTest(x: int, y: int);
  fn setHover(x: int, y: int): bool;
  fn setPressed(x: int, y: int): bool;
  fn clearPressed(): bool;
}

interface Interactive {
  fn activate(): bool;
}

// --- widgets ----------------------------------------------------------------

// A top-level window. `child` is usually a column or a row.
class Window implements Widget {
  title: string;
  width: int;
  height: int;
  child;
  background: int = 0xFFFFFFFF;
  x: int = 0;
  y: int = 0;
  w: int = 0;
  h: int = 0;

  fn init(title: string, width: int, height: int, child) {
    self.title = title;
    self.width = width;
    self.height = height;
    self.child = child;
  }

  fn measure(maxWidth: int, measure: function): array {
    return [self.width, self.height];
  }

  fn place(x: int, y: int, w: int, h: int, measure: function) {
    self.x = x;
    self.y = y;
    self.w = self.width;
    self.h = self.height;
    self.child.place(x, y, self.width, self.height, measure);
    return self;
  }

  fn collect(out: array) {
    _push(out, "rect", self.x, self.y, self.w, self.h, self.background, "", 0);
    self.child.collect(out);
  }

  fn hitTest(x: int, y: int) {
    if (!_contains(self, x, y)) {
      return nil;
    }
    return self.child.hitTest(x, y);
  }

  fn setHover(x: int, y: int): bool {
    return self.child.setHover(x, y);
  }

  fn setPressed(x: int, y: int): bool {
    return self.child.setPressed(x, y);
  }

  fn clearPressed(): bool {
    return self.child.clearPressed();
  }
}

// A vertical stack. `gap` is the space between two children.
class Column implements Widget {
  gap: int;
  children: array;
  x: int = 0;
  y: int = 0;
  w: int = 0;
  h: int = 0;

  fn init(gap: int, children: array) {
    self.gap = gap;
    self.children = children;
  }

  fn measure(maxWidth: int, measure: function): array {
    var width = 0;
    var height = 0;
    var first = true;
    for child in self.children {
      let size = child.measure(maxWidth, measure);
      width = _max(width, size[0]);
      if (first) {
        height = size[1];
        first = false;
      } else {
        height = height + self.gap + size[1];
      }
    }
    return [width, height];
  }

  fn place(x: int, y: int, w: int, h: int, measure: function) {
    self.x = x;
    self.y = y;
    self.w = w;
    self.h = h;
    var cursor = y;
    for child in self.children {
      let size = child.measure(w, measure);
      child.place(x, cursor, w, size[1], measure);
      cursor = cursor + size[1] + self.gap;
    }
    return self;
  }

  fn collect(out: array) {
    for child in self.children {
      child.collect(out);
    }
  }

  fn hitTest(x: int, y: int) {
    if (!_contains(self, x, y)) {
      return nil;
    }
    for child in self.children {
      let hit = child.hitTest(x, y);
      if (hit != nil) {
        return hit;
      }
    }
    return nil;
  }

  fn setHover(x: int, y: int): bool {
    var changed = false;
    for child in self.children {
      if (child.setHover(x, y)) {
        changed = true;
      }
    }
    return changed;
  }

  fn setPressed(x: int, y: int): bool {
    var changed = false;
    for child in self.children {
      if (child.setPressed(x, y)) {
        changed = true;
      }
    }
    return changed;
  }

  fn clearPressed(): bool {
    var changed = false;
    for child in self.children {
      if (child.clearPressed()) {
        changed = true;
      }
    }
    return changed;
  }
}

// A horizontal stack. `gap` is the space between two children.
class Row implements Widget {
  gap: int;
  children: array;
  x: int = 0;
  y: int = 0;
  w: int = 0;
  h: int = 0;

  fn init(gap: int, children: array) {
    self.gap = gap;
    self.children = children;
  }

  fn measure(maxWidth: int, measure: function): array {
    var width = 0;
    var height = 0;
    var first = true;
    for child in self.children {
      let size = child.measure(maxWidth, measure);
      if (first) {
        width = size[0];
        first = false;
      } else {
        width = width + self.gap + size[0];
      }
      height = _max(height, size[1]);
    }
    return [width, height];
  }

  fn place(x: int, y: int, w: int, h: int, measure: function) {
    self.x = x;
    self.y = y;
    self.w = w;
    self.h = h;
    var cursor = x;
    for child in self.children {
      let size = child.measure(w, measure);
      child.place(cursor, y, size[0], h, measure);
      cursor = cursor + size[0] + self.gap;
    }
    return self;
  }

  fn collect(out: array) {
    for child in self.children {
      child.collect(out);
    }
  }

  fn hitTest(x: int, y: int) {
    if (!_contains(self, x, y)) {
      return nil;
    }
    for child in self.children {
      let hit = child.hitTest(x, y);
      if (hit != nil) {
        return hit;
      }
    }
    return nil;
  }

  fn setHover(x: int, y: int): bool {
    var changed = false;
    for child in self.children {
      if (child.setHover(x, y)) {
        changed = true;
      }
    }
    return changed;
  }

  fn setPressed(x: int, y: int): bool {
    var changed = false;
    for child in self.children {
      if (child.setPressed(x, y)) {
        changed = true;
      }
    }
    return changed;
  }

  fn clearPressed(): bool {
    var changed = false;
    for child in self.children {
      if (child.clearPressed()) {
        changed = true;
      }
    }
    return changed;
  }
}

// Insets one child by `all` pixels on every side.
class Padding implements Widget {
  all: int;
  child;
  x: int = 0;
  y: int = 0;
  w: int = 0;
  h: int = 0;

  fn init(all: int, child) {
    self.all = all;
    self.child = child;
  }

  fn measure(maxWidth: int, measure: function): array {
    let inner = self.child.measure(maxWidth, measure);
    return [inner[0] + self.all * 2, inner[1] + self.all * 2];
  }

  fn place(x: int, y: int, w: int, h: int, measure: function) {
    self.x = x;
    self.y = y;
    self.w = w;
    self.h = h;
    self.child.place(x + self.all, y + self.all, w - self.all * 2,
                     h - self.all * 2, measure);
    return self;
  }

  fn collect(out: array) {
    self.child.collect(out);
  }

  fn hitTest(x: int, y: int) {
    if (!_contains(self, x, y)) {
      return nil;
    }
    return self.child.hitTest(x, y);
  }

  fn setHover(x: int, y: int): bool {
    return self.child.setHover(x, y);
  }

  fn setPressed(x: int, y: int): bool {
    return self.child.setPressed(x, y);
  }

  fn clearPressed(): bool {
    return self.child.clearPressed();
  }
}

// Empty vertical space.
class Spacer implements Widget {
  height: int;
  x: int = 0;
  y: int = 0;
  w: int = 0;
  h: int = 0;

  fn init(height: int) {
    self.height = height;
  }

  fn measure(maxWidth: int, measure: function): array {
    return [0, self.height];
  }

  fn place(x: int, y: int, w: int, h: int, measure: function) {
    self.x = x;
    self.y = y;
    self.w = w;
    self.h = h;
    return self;
  }

  fn collect(out: array) {}

  fn hitTest(x: int, y: int) {
    return nil;
  }

  fn setHover(x: int, y: int): bool {
    return false;
  }

  fn setPressed(x: int, y: int): bool {
    return false;
  }

  fn clearPressed(): bool {
    return false;
  }
}

// Black text at `size`. Use `withColor` for an explicit ARGB colour.
class Text implements Widget {
  content: string;
  size: int;
  color: int = 0xFF000000;
  x: int = 0;
  y: int = 0;
  w: int = 0;
  h: int = 0;

  fn init(content: string, size: int) {
    self.content = content;
    self.size = size;
  }

  fn withColor(color: int) {
    self.color = color;
    return self;
  }

  fn measure(maxWidth: int, measure: function): array {
    return [measure(self.content, self.size), int(self.size * 1.4)];
  }

  fn place(x: int, y: int, w: int, h: int, measure: function) {
    self.x = x;
    self.y = y;
    self.w = w;
    self.h = h;
    return self;
  }

  fn collect(out: array) {
    _push(out, "text", self.x, self.y + self.size, self.w, self.h, self.color,
          self.content, self.size);
  }

  fn hitTest(x: int, y: int) {
    return nil;
  }

  fn setHover(x: int, y: int): bool {
    return false;
  }

  fn setPressed(x: int, y: int): bool {
    return false;
  }

  fn clearPressed(): bool {
    return false;
  }
}

// A blue button with white text and distinct hover/pressed shades.
// `withStyle` and `withStates` replace the colours after construction.
class Button implements Widget, Interactive {
  label: string;
  onClick: function;
  size: int = 14;
  background: int = 0xFF2563EB;
  hoverBackground: int = 0xFF1D4ED8;
  pressedBackground: int = 0xFF1E40AF;
  color: int = 0xFFFFFFFF;
  hover: bool = false;
  pressed: bool = false;
  x: int = 0;
  y: int = 0;
  w: int = 0;
  h: int = 0;

  fn init(label: string, onClick: function) {
    self.label = label;
    self.onClick = onClick;
  }

  fn withStyle(background: int, color: int) {
    return self.withStates(background, background, background, color);
  }

  fn withStates(background: int, hoverBackground: int, pressedBackground: int,
                color: int) {
    self.background = background;
    self.hoverBackground = hoverBackground;
    self.pressedBackground = pressedBackground;
    self.color = color;
    return self;
  }

  fn measure(maxWidth: int, measure: function): array {
    return [measure(self.label, self.size) + 24, int(self.size * 1.4) + 16];
  }

  fn place(x: int, y: int, w: int, h: int, measure: function) {
    self.x = x;
    self.y = y;
    self.w = w;
    self.h = h;
    return self;
  }

  fn collect(out: array) {
    var fill = self.background;
    if (self.pressed) {
      fill = self.pressedBackground;
    } else if (self.hover) {
      fill = self.hoverBackground;
    }
    _push(out, "rect", self.x, self.y, self.w, self.h, fill, "", 0);
    _push(out, "text", self.x + 12, self.y + int((self.h + self.size) / 2),
          self.w - 24, self.size, self.color, self.label, self.size);
  }

  fn hitTest(x: int, y: int) {
    if (_contains(self, x, y)) {
      return self;
    }
    return nil;
  }

  fn setHover(x: int, y: int): bool {
    return _setHoverFlag(self, x, y);
  }

  fn setPressed(x: int, y: int): bool {
    return _setPressedFlag(self, x, y);
  }

  fn clearPressed(): bool {
    return _clearPressedFlag(self);
  }

  fn activate(): bool {
    self.onClick();
    return true;
  }
}

// A checkbox with a label. A click toggles `checked` and calls
// `onChange(checked)`; the callback sees the new state.
class Checkbox implements Widget, Interactive {
  label: string;
  checked: bool;
  onChange: function;
  size: int = 14;
  box: int = 16;
  gap: int = 8;
  background: int = 0xFFE5E7EB;
  hoverBackground: int = 0xFFD1D5DB;
  pressedBackground: int = 0xFF9CA3AF;
  checkedColor: int = 0xFF2563EB;
  color: int = 0xFF000000;
  hover: bool = false;
  pressed: bool = false;
  x: int = 0;
  y: int = 0;
  w: int = 0;
  h: int = 0;

  fn init(label: string, checked: bool, onChange: function) {
    self.label = label;
    self.checked = checked;
    self.onChange = onChange;
  }

  fn measure(maxWidth: int, measure: function): array {
    let labelWidth = measure(self.label, self.size);
    return [self.box + self.gap + labelWidth,
            _max(self.box, int(self.size * 1.4))];
  }

  fn place(x: int, y: int, w: int, h: int, measure: function) {
    self.x = x;
    self.y = y;
    self.w = w;
    self.h = h;
    return self;
  }

  fn collect(out: array) {
    var fill = self.background;
    if (self.pressed) {
      fill = self.pressedBackground;
    } else if (self.hover) {
      fill = self.hoverBackground;
    }
    _push(out, "rect", self.x, self.y, self.box, self.box, fill, "", 0);
    if (self.checked) {
      let inset = int(self.box / 4);
      _push(out, "rect", self.x + inset, self.y + inset,
            self.box - inset * 2, self.box - inset * 2, self.checkedColor, "", 0);
    }
    _push(out, "text", self.x + self.box + self.gap,
          self.y + int((self.h + self.size) / 2),
          self.w - self.box - self.gap, self.size, self.color, self.label,
          self.size);
  }

  fn hitTest(x: int, y: int) {
    if (_contains(self, x, y)) {
      return self;
    }
    return nil;
  }

  fn setHover(x: int, y: int): bool {
    return _setHoverFlag(self, x, y);
  }

  fn setPressed(x: int, y: int): bool {
    return _setPressedFlag(self, x, y);
  }

  fn clearPressed(): bool {
    return _clearPressedFlag(self);
  }

  fn activate(): bool {
    self.checked = !self.checked;
    self.onChange(self.checked);
    return true;
  }
}

// --- shared helpers ---------------------------------------------------------

fn _max(a, b) {
  if (a > b) {
    return a;
  }
  return b;
}

// The default advance used when no renderer supplies a font metric.
fn _fixedAdvance(text, size): int {
  return int(len(text) * size * 0.6);
}

fn _contains(node, x, y) {
  return x >= node.x && x < node.x + node.w && y >= node.y && y < node.y + node.h;
}

fn _setHoverFlag(node, x, y): bool {
  let next = _contains(node, x, y);
  if (node.hover != next) {
    node.hover = next;
    return true;
  }
  return false;
}

fn _setPressedFlag(node, x, y): bool {
  let next = _contains(node, x, y);
  if (node.pressed != next) {
    node.pressed = next;
    return true;
  }
  return false;
}

fn _clearPressedFlag(node): bool {
  if (node.pressed) {
    node.pressed = false;
    return true;
  }
  return false;
}

fn _push(out, kind, x, y, w, h, color, content, size) {
  out[len(out)] = {
    kind: kind,
    x: x,
    y: y,
    w: w,
    h: h,
    color: color,
    text: content,
    size: size,
  };
}

// --- entry points -----------------------------------------------------------

// Measures and places the tree with the default fixed advance.
fn layout(root, width, height) {
  return layoutWith(root, width, height, _fixedAdvance);
}

// Measures and places the tree with a renderer-supplied `measure(text, size)`
// that returns the advance width in pixels. A window uses its own size; any
// other root uses the viewport passed here.
fn layoutWith(root, width, height, measure) {
  if (type(root) == "Window") {
    return root.place(0, 0, root.width, root.height, measure);
  }
  return root.place(0, 0, width, height, measure);
}

// The draw commands for a laid-out tree, in paint order.
@MustUse
fn commands(root) {
  var out = [];
  root.collect(out);
  return out;
}

// The deepest interactive widget (`Button` or `Checkbox`) under `(x, y)`, or
// nil.
@MustUse
fn hitTest(root, x, y) {
  return root.hitTest(x, y);
}

// Updates the hovered interactive widget under `(x, y)`. Returns whether a
// widget changed state, so a caller can decide to redraw.
@MustUse
fn pointerMove(root, x, y): bool {
  return root.setHover(x, y);
}

// Marks the interactive widget under `(x, y)` as pressed and clears every
// other one.
@MustUse
fn pointerDown(root, x, y): bool {
  let hovered = root.setHover(x, y);
  let pressed = root.setPressed(x, y);
  return hovered || pressed;
}

// Clears hover and pressed when the pointer leaves the window or the window
// loses focus, so no widget keeps a stale highlight.
@MustUse
fn pointerCancel(root): bool {
  let hovered = root.setHover(-1, -1);
  let pressed = root.clearPressed();
  return hovered || pressed;
}

// Releases the pointer. A button's `onClick` or a checkbox's `onChange` runs
// only when the press and the release land on the same widget; the pressed
// state is always cleared.
@MustUse
fn pointerUp(root, x, y): bool {
  _ = root.setHover(x, y);
  let hit = root.hitTest(x, y);
  var pressed = false;
  if (hit != nil && hit.pressed) {
    pressed = true;
  }
  _ = root.clearPressed();
  if (!pressed) {
    return false;
  }
  return hit.activate();
}

// A complete press/release at one point, for headless callers. Returns whether
// a handler ran or a checkbox changed state.
@MustUse
fn click(root, x, y): bool {
  _ = pointerDown(root, x, y);
  return pointerUp(root, x, y);
}
