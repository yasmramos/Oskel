// `std.uuid`: v5 against the Python reference vectors, the accepted
// input forms, v4 under a fixed seed, and the error paths.
import std.uuid.*;
import std.uuid as u;

print("nil =", nilUuid());
print("v5 dns python =", v5(NAMESPACE_DNS, "python.org"));
print("v5 url example =", v5(NAMESPACE_URL, "https://example.com"));
print("v5 dns ejemplo =", v5(NAMESPACE_DNS, "ejemplo.es"));
print("v5 oid =", v5(NAMESPACE_OID, "1.3.6.1"));
print("v5 upper ns =", v5("6BA7B810-9DAD-11D1-80B4-00C04FD430C8", "python.org"));
let x = "886313e1-3b8a-5372-9b90-0c9aee199e5d";
print("valid =", isValid(x), isValid("{" + x + "}"), isValid("urn:uuid:" + x), isValid(x.upper()));
print("bytes =", parse(x));
print("format =", format(parse(x)));
print("normalize =", normalize(x.upper()));
print("version =", version(x), "variant =", variant(x));
print("isNil =", isNil(nilUuid()), isNil(x));
print("compare =", compare(x, x), compare(x, nilUuid()), compare(nilUuid(), x));
seed(42);
let a = v4();
print("v4 seeded =", a, version(a), variant(a), isValid(a));
print("v4 next =", v4());
print("bad =", tryParse("nope").ok, tryParse("nope").error);
print("bad2 =", tryParse("886313e1-3b8a-5372-9b90-0c9aee199e5").ok);
print("bad3 =", tryParse(42).ok);
print("pcall =", pcall(() => parse("nope")).ok);
print("pcall2 =", pcall(() => v5(x, 42)).ok);
print("uuid ok");
