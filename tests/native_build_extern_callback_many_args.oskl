extern "C" {
  fn call7(cb: fn(int32, int32, int32, int32, int32, int32, int32): int32,
           a: int32, b: int32, c: int32, d: int32, e: int32, f: int32,
           g: int32): int32;
  fn call8(cb: fn(int32, int32, int32, int32, int32, int32, int32, int32): int32,
           args: ptr): int32;
}

fn sum7(a: int32, b: int32, c: int32, d: int32, e: int32, f: int32,
        g: int32): int32 {
  return a + b + c + d + e + f + g;
}

fn sum8(a: int32, b: int32, c: int32, d: int32, e: int32, f: int32,
        g: int32, h: int32): int32 {
  return a + b + c + d + e + f + g + h;
}

fn storeInt(p: ptr, offset: int32, value: int32): void {
  storeByte(p, offset, value & 255);
  storeByte(p, offset + 1, (value >> 8) & 255);
  storeByte(p, offset + 2, (value >> 16) & 255);
  storeByte(p, offset + 3, (value >> 24) & 255);
}

assertEq(call7(sum7, 1, 2, 3, 4, 5, 6, 7), 28);

let args = buffer(4 * 8);
for (var i = 0; i < 8; i = i + 1) {
  storeInt(args, i * 4, i + 1);
}
assertEq(call8(sum8, args), 36);

print("many args callback ok");
