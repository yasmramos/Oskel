// Fixture for the class-module convention: the PascalCase file name is the
// class name, and the file exports exactly one public name. `_shift` is private
// and stays reachable from the class methods, not from the importer.

fn _shift(n: int): int {
  return n + 1;
}

class Point {
  x: int;
  y: int;

  fn init(x: int, y: int) {
    self.x = x;
    self.y = y;
  }

  fn sum(): int {
    return _shift(self.x + self.y) - 1;
  }
}
