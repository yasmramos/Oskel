// PHASE 12.2: a module that imports an interface and implements it in a local
// class. The interface is not re-exported; the class is.

import { Shape } from modules.interface_geom;

class NestedSquare implements Shape {
  side: double;
  fn init(side: double) { self.side = side; }
  fn area(): double { return self.side * self.side; }
  fn name(): string { return "nested-square"; }
}
