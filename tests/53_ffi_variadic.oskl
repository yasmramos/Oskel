// requires: x86-64
// C variadics in `extern "C"` declarations (PHASE 6.6). A trailing bare `...`
// declares a C variadic: the named parameters are the fixed prefix and every
// extra argument is passed through the default argument promotions (`float`
// widens to `double`, `bool` to `int`, a string to `const char *`). The call
// goes through the engine's descriptor stub, which follows the host's x86-64
// ABI (System V AMD64 or Microsoft x64), so the declaration is rejected at
// compile time where that is unavailable and this test is skipped by CMake.
// The function below is a standard C library name.

extern "C" {
  fn printf(fmt: cstring, ...): int;
}

// `%s`, `%d` and `%.1f` read a string, an int and a double. A Oskel `float`
// literal is a C `float`, promoted to `double`, so `%.1f` still sees 2.5. The
// return value is the number of bytes written, so the assertion covers the
// formatted values: "id-7-2.5\n" is nine bytes.
let written = printf("%s-%d-%.1f\n", "id", 7, 2.5);
assertEq(written, 9);

// A variadic call may pass only the named prefix: the tail is empty.
let empty = printf("plain\n");
assertEq(empty, 6);

// The trailing arguments are checked only for count, not for type: an int, a
// bool and a double all cross the boundary. "1-1-0\n" is six bytes.
let mixed = printf("%d-%d-%d\n", 1, true, 0);
assertEq(mixed, 6);

// The fifth value is on the outgoing stack in the Microsoft x64 ABI, after the
// four register arguments. "1-2-3-2.5\n" is ten bytes.
let stacked = printf("%d-%d-%d-%.1f\n", 1, 2, 3, 2.5);
assertEq(stacked, 10);

print("ffi variadic ok");
