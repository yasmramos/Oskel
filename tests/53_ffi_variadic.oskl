// requires: libffi
// C variadics in `extern "C"` declarations (PHASE 6.6). A trailing bare `...`
// declares a C variadic: the named parameters are the fixed prefix and every
// extra argument is passed through the default argument promotions (`float`
// widens to `double`, `bool` to `int`, a string to `const char *`). The call
// goes through libffi (`ffi_prep_cif_var`) with the System V AMD64 layout, so
// the declaration is rejected at compile time where that is unavailable and this
// test is skipped by CMake. The functions below are standard C library names.

extern "C" {
  // `snprintf` formats into a caller buffer; the trailing arguments are variadic.
  fn snprintf(buf: cstring, size: size_t, fmt: cstring, ...): int;
  fn strlen(s: cstring): size_t;
}

// `%s`, `%d` and `%.1f` read a string, an int and a double. A Oskel `float`
// literal is a C `float`, promoted to `double`, so `%.1f` still sees 2.5.
let buf = cstring("                    ");
let written = snprintf(buf, 21, "%s-%d-%.1f", "id", 7, 2.5);
assertEq(written, 8);
assertEq(cstr(buf), "id-7-2.5");
assertEq(strlen(buf), 8);

// A variadic call may pass only the named prefix: the tail is empty.
let empty = snprintf(buf, 21, "plain");
assertEq(empty, 5);
assertEq(cstr(buf), "plain");

// The trailing arguments are checked only for count, not for type: an int, a
// bool and a double all cross the boundary.
let mixed = snprintf(buf, 21, "%d-%d-%d", 1, true, 0);
assertEq(mixed, 5);
assertEq(cstr(buf), "1-1-0");

print("ffi variadic ok");
