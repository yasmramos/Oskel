// Fixture for `oskel build` (tests/build_binary.cmake).
//
// The allocating array methods bound by PHASE 7c.3f: `slice`, `concat`,
// `reversed` and `clone`. Unlike the in-place methods (PHASE 7c.3c/7c.3e),
// each returns a *new* array and leaves the receiver untouched, so the AOT
// backend must allocate a fresh header plus its items block from the arena.
// The backend used to answer each with "value has no such member". This
// fixture is checked against the VM, so the returned arrays, the receiver's
// immutability and the detached-binder behaviour are all pinned by a real
// program.

var a = [1, 2, 3, 4, 5];

// `slice(start?, end?)`: both bounds are optional, a negative bound counts
// from the end, every bound is clamped, and `end < start` yields an empty
// array. The receiver is unchanged.
print(a.slice());
print(a.slice(1));
print(a.slice(1, 3));
print(a.slice(-2));
print(a.slice(1, -1));
print(a.slice(10));
print(a.slice(-10, 10));
print(a.slice(3, 1));
print(a);

// `concat(other)`: the receiver's items followed by `other`'s, as a new array.
print(a.concat([6, 7]));
print(a.concat([]));
print(a);
print([].concat(a));

// `reversed()`: a new array with the items in reverse order.
print(a.reversed());
print(a);
print([].reversed());

// `clone()`: a shallow copy; a write through the copy does not reach the
// receiver.
var c = a.clone();
c.push(9);
print(c);
print(a);
print([].clone());

// Nested arrays copy by reference (shallow), so the copy shares the inner
// arrays with the receiver, exactly like the VM.
var d = [[1], [2, 3]];
print(d.slice(1));
print(d.reversed());
print(d.concat([[9]]));

// The methods are first-class: a detached binder still reads the receiver it
// captured.
var s = a.slice;
var rv = a.reversed;
var cc = a.clone;
var ct = a.concat;
print(s(1, 3));
print(rv());
print(cc());
print(ct([8]));
