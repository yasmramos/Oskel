extern "C" {
  fn register_exit_callback(cb: fn(): void): void;
}

var total = 0;

fn late(): void {
  total = total + 1;
  print("late callback " + str(total));
}

register_exit_callback(late);

// Allocate after registration: the root epilogue must publish this final arena
// cursor, not the one captured when the callback was created.
var marker = "kept";
print("before return");
assertEq(marker, "kept");
