// Every fixed-arity builtin must reject a call with the wrong argument count,
// exactly like the VM (BACKLOG §6 item 25). Without the guard the AOT builtin
// read its operand from an argument window that was never written -- `type()`
// returned a garbage type name built from whatever happened to sit there -- and
// a second argument was silently ignored (`chr(65, 1)` returned "A"). The
// Both engines word the failure identically -- `<name>() expects N argument(s),
// got M` -- so this fixture prints the message itself: a divergence in the text
// is a failure, not a detail (PHASE 7c.5b.6).
//
// `pcall` is what makes this testable end to end: a raised runtime error is not
// a value, so `try`/`catch` does not see it, while `pcall` hands back
// `{ok, value, error}`.

fn noArgsLen(): any { return len(); }
fn extraLen(): any { return len([1], 2); }
fn noArgsType(): any { return type(); }
fn extraType(): any { return type(1, 2); }
fn noArgsStr(): any { return str(); }
fn extraStr(): any { return str(1, 2); }
fn noArgsRepr(): any { return repr(); }
fn extraRepr(): any { return repr(1, 2); }
fn noArgsBool(): any { return bool(); }
fn extraBool(): any { return bool(1, 2); }
fn noArgsIsError(): any { return isError(); }
fn extraIsError(): any { return isError(1, 2); }
fn noArgsOrd(): any { return ord(); }
fn extraOrd(): any { return ord("a", "b"); }
fn noArgsChr(): any { return chr(); }
fn extraChr(): any { return chr(65, 1); }
fn noArgsFsOpen(): any { return fsOpen(); }
fn extraFsOpen(): any { return fsOpen("a", "r", 1); }
fn noArgsFsRead(): any { return fsRead(); }
fn extraFsRead(): any { return fsRead("a", 1, 2); }
fn noArgsFsWrite(): any { return fsWrite(); }
fn extraFsWrite(): any { return fsWrite("a", "b", 1); }
fn noArgsFsSeek(): any { return fsSeek(); }
fn extraFsSeek(): any { return fsSeek("a", 0, "s", 1); }
fn noArgsFsClose(): any { return fsClose(); }
fn extraFsClose(): any { return fsClose("a", 1); }

fn reported(f: any): string {
  let r = pcall(f);
  if (r.ok) { return "no error"; }
  if (r.error == nil) { return "nil error"; }
  return r.error.message;
}

print(reported(noArgsLen));
print(reported(extraLen));
print(reported(noArgsType));
print(reported(extraType));
print(reported(noArgsStr));
print(reported(extraStr));
print(reported(noArgsRepr));
print(reported(extraRepr));
print(reported(noArgsBool));
print(reported(extraBool));
print(reported(noArgsIsError));
print(reported(extraIsError));
print(reported(noArgsOrd));
print(reported(extraOrd));
print(reported(noArgsChr));
print(reported(extraChr));
print(reported(noArgsFsOpen));
print(reported(extraFsOpen));
print(reported(noArgsFsRead));
print(reported(extraFsRead));
print(reported(noArgsFsWrite));
print(reported(extraFsWrite));
print(reported(noArgsFsSeek));
print(reported(extraFsSeek));
print(reported(noArgsFsClose));
print(reported(extraFsClose));

// The one-argument form still works, so the guard did not break the happy path.
print(len("abcd"));
print(type(1));
print(str(42));
print(repr("x"));
print(bool(0));
print(isError(error("boom")));
print(ord("A"));
print(chr(66));

// The math builtins report a wrong count, not a wrong type.
fn noArgsFloor(): any { return floor(); }
fn extraFloor(): any { return floor(1, 2); }
fn noArgsPow(): any { return pow(); }
fn extraPow(): any { return pow(1, 2, 3); }
fn noArgsSin(): any { return sin(); }
fn noArgsExp(): any { return exp(); }
print(reported(noArgsFloor));
print(reported(extraFloor));
print(reported(noArgsPow));
print(reported(extraPow));
print(reported(noArgsSin));
print(reported(noArgsExp));

// A user function names itself and its declared arity; a variadic one says
// "or more" for the fixed part. The compiler rejects a direct call with the
// wrong count, so the run-time guard is reached through an indirect one: the
// callee is a value of unknown type (`any`), exactly like the VM.
fn two(a: int64, b: int64): int64 { return a + b; }
fn none(): int64 { return 0; }
fn atLeast(a: int64, rest...) { return a; }
fn callTwo0(): any { let t: any = two; return t(); }
fn callTwo3(): any { let t: any = two; return t(1, 2, 3); }
fn callNone1(): any { let n: any = none; return n(1); }
fn callAtLeast0(): any { let a: any = atLeast; return a(); }
print(reported(callTwo0));
print(reported(callTwo3));
print(reported(callNone1));
print(reported(callAtLeast0));

// `error()` takes one or two arguments and says so.
fn error0(): any { return error(); }
fn error3(): any { return error("a", 1, 2); }
print(reported(error0));
print(reported(error3));
