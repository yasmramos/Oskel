// Fixture for the hosted `extern "C"` test (tests/build_hosted_extern.cmake).
//
// A scalar `extern "C"` declaration is a host binding the freestanding backend
// still rejects (it has no host), but the hosted backend resolves it through
// the system linker (PHASE 7f.5): each symbol gets a marshalling thunk and the
// chunk seeds it as a function, so the calls reach the real C functions.
//
// The signatures cover the register classes the thunk marshals: a general-
// purpose integer (including a fixed width, which the thunk normalizes back to
// its declared width), an SSE double, and a `void` return. PHASE 7f.6 adds the
// pointer class: a `cstring` parameter travels as a `const char *` (the thunk
// materialises a NUL-terminated copy of the Oskel string in the arena) and a
// `cstring` return is scanned back into an Oskel string.
extern "C" {
  fn abs(x: int): int;
  fn labs(x: int64): int64;
  fn getpid(): int;
  fn fabs(x: double): double;
  fn fmod(a: double, b: double): double;
  fn strlen(s: cstring): size_t;
  fn strcmp(a: cstring, b: cstring): int;
  fn strncmp(a: cstring, b: cstring, n: size_t): int;
  fn strchr(s: cstring, c: int): cstring;
}

assertEq(abs(-7), 7);
assertEq(labs(-9000000000), 9000000000);
assertEq(getpid() > 0, true);
assertEq(fabs(-2.5), 2.5);
assertEq(fmod(7.5, 2.0), 1.5);

// A Oskel string is a valid `const char *`: NUL-terminated for the whole call.
assertEq(strlen("hello"), 5);
assertEq(strlen(""), 0);
assertEq(strcmp("abc", "abc"), 0);
assertEq(strcmp("abc", "abd") < 0, true);
// A `size_t` argument travels in a GPR after two pointers, and the integer
// arguments are staged so a later `alloc` (from a pointer argument) cannot
// clobber them.
assertEq(strncmp("hello", "help", 3), 0);
assertEq(strncmp("hello", "help", 4) != 0, true);

// A `cstring` return is a pointer handle, not a string (BACKLOG §6 item 23):
// `type()` says "cstring", equality is handle identity and `+` rejects it, all
// exactly as the VM. A NULL pointer (`strchr` with no match) becomes `nil`.
var found = strchr("hello", 108);
assertEq(type(found), "cstring");
assertEq(found == nil, false);
assertEq(found == found, true);
// Handle identity, not text equality: a `cstring` never equals a string.
assertEq(found == "llo", false);
// The bytes are still the C function's: feeding the handle back into a C
// function must reproduce them (the thunk passes a `Ptr` through as its own
// NUL-terminated address).
assertEq(strcmp(found, "llo"), 0);
assertEq(byteLen(found), 3);
assertEq(strchr("hello", 122) == nil, true);

print("extern hosted ok");
