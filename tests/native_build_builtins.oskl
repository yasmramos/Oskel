// Fixture for `oskel build` (tests/build_binary.cmake): the remaining public
// builtins (PHASE 7c.5b.5) -- `range`, `assertEq` and `exit` -- must compile to
// the AOT backend and behave exactly like the development VM. The output is
// asserted byte for byte by the CMake script, and this file also runs on the VM
// as an ordinary script test, which is the reference.
print(range(5));
print(range(1, 4));
print(range(-2, 2));
assertEq(range(0, 3).length, 3);
assertEq("a" + "b", "ab");
assertEq([1, 2], [1, 2]);
assertEq(nil, nil);
print("builtins ok");
exit(0);
print("unreachable");
