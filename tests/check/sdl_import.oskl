// `-c` only: `std.internal.sdl` parses and type-checks on every platform, without SDL3
// installed. The symbols are resolved at run time (the development engine) or
// at link time (`oskel build --mode hosted --link-lib SDL3`), so a compile-only
// check needs neither.
//
// Registered by the `tests/check/*.oskl` glob, which runs `oskel -c` and
// requires exit 0 and empty stdout.

import std.internal.sdl;

fn drawSample(renderer: ptr): bool {
  let rect = std.internal.sdl.fRectBuffer();
  std.internal.sdl.setFRect(rect, 10, 20, 30, 40);
  return std.internal.sdl.fillRect(renderer, rect);
}
