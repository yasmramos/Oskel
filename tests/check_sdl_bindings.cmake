# `std/internal/sdl.oskl`'s `extern "C"` block is generated by `bindgen` from
# `bindings/sdl/sdl3_subset.h`; the helpers below it are hand-written, so a
# plain file comparison cannot work. This compares only the block, from the
# `extern "C" {` line through its closing `}`.
#
# What it catches: a signature edited in the header but not regenerated in the
# module. Both spellings compile, so the divergence would only surface at the
# ABI boundary (a wrong argument type, a missing symbol) at run time.
#
# Expects:
#   -DBINDGEN=<path to the bindgen executable>
#   -DHEADER=<the curated C header>
#   -DMODULE=<the .oskl module>

if(NOT DEFINED BINDGEN OR NOT DEFINED HEADER OR NOT DEFINED MODULE)
  message(FATAL_ERROR "check_sdl_bindings.cmake requires BINDGEN, HEADER and MODULE")
endif()

execute_process(
  COMMAND "${BINDGEN}" "${HEADER}"
  RESULT_VARIABLE bindgen_exit
  OUTPUT_VARIABLE generated
  ERROR_VARIABLE bindgen_stderr
)
if(NOT bindgen_exit EQUAL 0)
  message(FATAL_ERROR "bindgen failed (exit ${bindgen_exit}):\n${bindgen_stderr}")
endif()

file(READ "${MODULE}" module_text)

function(extract_block text out)
  string(FIND "${text}" "extern \"C\" {" start)
  if(start EQUAL -1)
    message(FATAL_ERROR "no 'extern \"C\" {' block found")
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "\n}" end)
  if(end EQUAL -1)
    message(FATAL_ERROR "the 'extern \"C\" {' block is not closed")
  endif()
  math(EXPR length "${end} + 2")
  string(SUBSTRING "${rest}" 0 ${length} block)
  set(${out} "${block}" PARENT_SCOPE)
endfunction()

extract_block("${generated}" generated_block)
extract_block("${module_text}" module_block)

if(NOT generated_block STREQUAL module_block)
  message(FATAL_ERROR
    "std/internal/sdl.oskl is out of date with bindings/sdl/sdl3_subset.h.\n"
    "Run ./build/bindgen bindings/sdl/sdl3_subset.h and replace the block.\n"
    "--- generated ---\n${generated_block}\n"
    "--- module ---\n${module_block}")
endif()
