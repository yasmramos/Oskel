// The AOT callback body cannot rebuild a struct return from the C registers
// (the hosted engine can, through libffi). The build must reject it with the
// dedicated message and write no binary.
struct Point {
  x: int;
  y: int;
}

extern "C" {
  fn call_struct(cb: fn(): Point): Point;
}

fn make(): Point {
  return Point { x: 1, y: 2 };
}

let p = call_struct(make);
print(p.x);
