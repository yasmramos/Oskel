// `std.fs.dir` is VM-only for now: the x86-64 AOT backend has no directory
// handles, so `oskel build` must reject the module with a named error and exit
// 65 instead of emitting an image that traps at run time.
//
// This is a build-error input, not a VM test (`tests/errors/` is outside the
// `tests/*.oskl` glob).
import std.fs.dir;

fn main() {
  print(std.fs.dir.listDir("."));
}

main();
