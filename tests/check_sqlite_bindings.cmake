# `std/internal/sqlite_bindings.oskl` is generated by `bindgen` from
# `bindings/sqlite/sqlite3_subset.h`; a signature edited in the header without
# regenerating the module is invisible to the compiler (both spellings compile)
# and only fails at the ABI boundary. This compares the whole file, so the
# constants, the function signatures and the skipped-declaration comments stay
# in step.
#
# The header is passed relative to the source root because the generated
# comment names it; the caller sets WORKING_DIR.
#
# Expects:
#   -DBINDGEN=<path to the bindgen executable>
#   -DHEADER=<the curated C header, relative to WORKING_DIR>
#   -DMODULE=<the checked-in .oskl module>
#   -DWORKING_DIR=<the source root>

if(NOT DEFINED BINDGEN OR NOT DEFINED HEADER OR NOT DEFINED MODULE OR NOT DEFINED WORKING_DIR)
  message(FATAL_ERROR "check_sqlite_bindings.cmake requires BINDGEN, HEADER, MODULE and WORKING_DIR")
endif()

execute_process(
  COMMAND "${BINDGEN}" "${HEADER}"
  WORKING_DIRECTORY "${WORKING_DIR}"
  RESULT_VARIABLE bindgen_exit
  OUTPUT_VARIABLE generated
  ERROR_VARIABLE bindgen_stderr
)
if(NOT bindgen_exit EQUAL 0)
  message(FATAL_ERROR "bindgen failed (exit ${bindgen_exit}):\n${bindgen_stderr}")
endif()

file(READ "${MODULE}" module_text)

# A Windows checkout may turn the checked-in file's LF into CRLF; the generated
# text is LF. Normalise both before comparing, so a line-ending setting does
# not hide or invent a content difference.
string(REPLACE "\r\n" "\n" generated "${generated}")
string(REPLACE "\r\n" "\n" module_text "${module_text}")

if(NOT generated STREQUAL module_text)
  message(FATAL_ERROR
    "std/internal/sqlite_bindings.oskl is out of date with bindings/sqlite/sqlite3_subset.h.\n"
    "Regenerate it with:\n"
    "  ./build/bindgen bindings/sqlite/sqlite3_subset.h > std/internal/sqlite_bindings.oskl\n"
    "--- generated ---\n${generated}\n"
    "--- module ---\n${module_text}")
endif()
