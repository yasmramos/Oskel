// Shortest round-trip formatting, shared by the VM (`std::to_chars`) and the
// WASM backend. The scientific forms and the subnormal at the bottom of the
// range are the cases a fixed-point formatter gets wrong.
print(double("1e300"));
print(double("1.5e300"));
print(double("1e-150"));
print(double("1.5e-150"));
print(double("1e150"));
print(double("1.2345678901234567e150"));
print(double("1e-5"));
print(double("0.0001"));
print(double("1e4"));
print(double("1e5"));
print(double("1e17"));
print(double("1e18"));
print(double("1e19"));
print(double("5e-324"));
print(double("2.2250738585072014e-308"));
print(double("1.7976931348623157e308"));
print(-0.0);
print(0.0);
print(1.0);
print(100.0);
print(1000000.0);
print(1.0 / 3.0);
print(123456789.123);
print(3.141592653589793);
print(2.718281828459045);
print(1.4142135623730951);
