// VM/AOT parity for the streaming half of `std.fs` (PHASE 7g).
//
// `tests/build_binary.cmake` runs this under the VM and under `oskel build`,
// then compares the output byte for byte. It covers both halves of the module:
// the streaming surface (`std.fs.File` and the whole-file helpers) and the
// directory/metadata surface in `std.fs.dir`.
import std.fs;
import std.fs.File as DirectFile;
import std.fs.dir;

fn cleanDir(path: string) {
  if (std.fs.dir.exists(path)) {
    for name in std.fs.dir.listDir(path) {
      std.fs.dir.remove(path + "/" + name);
    }
    std.fs.dir.removeDir(path);
  }
}

fn main() {
  let path = "oskel_native_fs_fixture.txt";
  std.fs.writeText(path, "alpha\nbeta\n");
  std.fs.appendText(path, "gamma\n");

  let direct = DirectFile(path, "r");
  print(direct.readLine());
  direct.close();

  let file = std.fs.open(path, "r");
  defer { file.close(); }
  print(file.readLine());
  print(file.readLine());
  print(file.readLine());
  print(file.readLine());
  print(file.size());
  print(file.eof());

  file.seek(0, "start");
  print(file.read(5));
  print(file.position());
  print(file.readAll());
  print(file.isClosed());

  file.close();
  print(file.isClosed());
  print(std.fs.readText(path));
  print(std.fs.exists(path));
  print(std.fs.exists("oskel_native_fs_missing.txt"));

  let dir = "oskel_native_fs_dir_fixture";
  cleanDir(dir);
  let original = std.fs.dir.currentDir();
  std.fs.dir.makeDir(dir);
  std.fs.dir.changeDir(dir);

  std.fs.writeText("a.txt", "one\n");
  std.fs.writeText("b.txt", "two\n");
  std.fs.dir.makeDir("sub");
  print(std.fs.dir.listDir("."));

  let info = std.fs.dir.stat("a.txt");
  print(info.size);
  print(info.isFile);
  print(info.isDir);
  print(info.modified > 0);
  print(std.fs.dir.stat("sub").isDir);
  print(std.fs.dir.exists("a.txt"));
  print(std.fs.dir.isDir("sub"));

  std.fs.dir.rename("a.txt", "c.txt");
  print(std.fs.dir.listDir("."));
  std.fs.dir.remove("c.txt");
  std.fs.dir.removeDir("sub");
  print(std.fs.dir.listDir("."));

  std.fs.dir.changeDir(original);
  cleanDir(dir);
  print(std.fs.dir.currentDir() == original);
}

main();
