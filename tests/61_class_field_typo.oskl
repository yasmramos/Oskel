// PHASE 6.8.1: a mistyped field assignment on a class instance is a runtime
// error.
//
// A class instance is closed over its declared fields. A name the class never
// declared cannot be added, so a typo such as `cont` for `count` fails loudly
// instead of silently creating a second field while every read of the real one
// keeps returning its old value.

class Counter {
  count: int;
  fn init() { self.count = 0; }
  fn bump() { self.count = self.count + 1; }
}

// `cont` is one edit from `count`: it is not a declared field.
let c = Counter();
let typo = pcall(() => { c.cont = 5; });
assertEq(typo.ok, false);
assertEq(typo.error.message, "class 'Counter' has no field 'cont'");
assertEq(c.count, 0);

// A deliberate new key is rejected the same way: the shape is fixed.
let extra = pcall(() => { c.visits = 1; });
assertEq(extra.ok, false);

// A correctly spelled field is a plain assignment.
c.count = 7;
c.bump();
assertEq(c.count, 8);

print("class field typo ok");
