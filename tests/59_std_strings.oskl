// std.strings: words, blankness, occurrences, padding and shortening.
//
// The module is pure Oskel over the portable primitive surface (indexing,
// slicing, `len`, `for ... in`, closures, `panic`), so every expected value
// here must hold on the development VM, under `oskel build` and on WebAssembly
// (see `tests/native_build_strings.oskl`).

import std.strings;
import std.strings.*;
import std.strings as t;
import { truncate, words } from std.strings;

// --- words ------------------------------------------------------------------

assertEq(words("  a  bb\tccc "), ["a", "bb", "ccc"]);
assertEq(words("a\tb\nc\rd"), ["a", "b", "c", "d"]);
assertEq(words(""), []);
assertEq(words("   "), []);
assertEq(words("one"), ["one"]);
// A non-breaking space is not ASCII whitespace, matching `trim()`.
assertEq(words("a\u00A0b"), ["a\u00A0b"]);

// --- isBlank ----------------------------------------------------------------

assertEq(isBlank(""), true);
assertEq(isBlank("   "), true);
assertEq(isBlank(" \t\n\r\u000B\u000C"), true);
assertEq(isBlank(" a "), false);
assertEq(isBlank("\u00A0"), false);

// --- countOf / indexOfAll ---------------------------------------------------

assertEq(countOf("banana", "an"), 2);
assertEq(countOf("banana", "ana"), 1);
assertEq(countOf("aaaa", "aa"), 2);
assertEq(countOf("abc", ""), 0);
assertEq(countOf("abc", "abcd"), 0);
assertEq(countOf("", ""), 0);
assertEq(countOf("héhé", "é"), 2);

assertEq(indexOfAll("banana", "an"), [1, 3]);
assertEq(indexOfAll("aaaa", "aa"), [0, 2]);
assertEq(indexOfAll("abc", ""), []);
assertEq(indexOfAll("abc", "z"), []);
assertEq(indexOfAll("héhé", "é"), [1, 3]);

// --- containsAll / containsAny ----------------------------------------------

assertEq(containsAll("abc", ["a", "c"]), true);
assertEq(containsAll("abc", ["a", "z"]), false);
assertEq(containsAll("abc", []), true);
assertEq(containsAll("abc", ["", "a"]), true);
assertEq(containsAll("", [""]), true);
assertEq(containsAny("abc", ["z", "b"]), true);
assertEq(containsAny("abc", ["z", "y"]), false);
assertEq(containsAny("abc", []), false);
assertEq(containsAny("abc", ["", "z"]), true);

// --- padBoth ----------------------------------------------------------------

assertEq(padBoth("ab", 5, " "), " ab  ");
assertEq(padBoth("ab", 6, "-="), "-=ab-=");
assertEq(padBoth("ab", 4, "*"), "*ab*");
assertEq(padBoth("abc", 2, " "), "abc");
assertEq(padBoth("", 4, "*"), "****");
assertEq(padBoth("é", 3, "."), ".é.");

// --- truncate ---------------------------------------------------------------

assertEq(truncate("abcdef", 6, "..."), "abcdef");
assertEq(truncate("abcdef", 7, "..."), "abcdef");
assertEq(truncate("abcdef", 4, "..."), "a...");
assertEq(truncate("abcdef", 2, "..."), "..");
assertEq(truncate("abcdef", 3, "..."), "...");
assertEq(truncate("abcdef", 0, "..."), "");
assertEq(truncate("abcdef", 4, ""), "abcd");
assertEq(truncate("héllo", 4, "…"), "hél…");

// --- import forms -----------------------------------------------------------

assertEq(std.strings.words("ok"), ["ok"]);
assertEq(t.words("ok"), ["ok"]);
assertEq(words("ok"), ["ok"]);
assertEq(truncate("abcdef", 4, "..."), "a...");

// `_isSpace` and `_contains` are private and are not exported.
assertEq(std.strings._isSpace, nil);
assertEq(std.strings._contains, nil);

print("std.strings ok");
