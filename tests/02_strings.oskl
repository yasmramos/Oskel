// String literals, interpolation and methods.

var name = "Oskel";
assertEq("Hello, ${name}!", "Hello, Oskel!");
assertEq("1+2=${1 + 2}", "1+2=3");
assertEq("len=${"abc".length}", "len=3");
assertEq("nested ${"inner ${name}"}", "nested inner Oskel");
assertEq("map ${ {a: 1}.a }", "map 1");
assertEq("\u00e9", "é");
assertEq("\x41", "A");
assertEq("a\tb", "a" + chr(9) + "b");
assertEq("\$5", "$5");

assertEq("áé".length, 2);
assertEq(len("áé"), 2);
assertEq("áé"[1], "é");
assertEq("áé"[-1], "é");

assertEq("Hello".upper(), "HELLO");
assertEq("Hello".lower(), "hello");
assertEq("  x  ".trim(), "x");
assertEq("  x  ".trimStart(), "x  ");
assertEq("  x  ".trimEnd(), "  x");
assertEq("a,b,c".split(","), ["a", "b", "c"]);
assertEq("a b  c".split(), ["a", "b", "c"]);
// With no argument, `split` breaks on runs of ASCII whitespace with no leading
// or trailing empty field: the separator is the same one `trim*` uses.
assertEq("  a  b  ".split(), ["a", "b"]);
assertEq("a\tb\nc\rd".split(), ["a", "b", "c", "d"]);
assertEq("one".split(), ["one"]);
assertEq("".split(), []);
assertEq("   ".split(), []);
assertEq("\t\n ".split(), []);
// A separator argument still keeps empty fields, including at the edges.
assertEq("a,,b".split(","), ["a", "", "b"]);
assertEq(",a,".split(","), ["", "a", ""]);
assertEq("abc".split(""), ["a", "b", "c"]);
assertEq("abc".chars(), ["a", "b", "c"]);
assertEq("a-b".replace("-", "+"), "a+b");
assertEq("a-a".replaceFirst("a", "b"), "b-a");
assertEq("abc".startsWith("ab"), true);
assertEq("abc".endsWith("bc"), true);
assertEq("abc".contains("b"), true);
assertEq("abc".indexOf("c"), 2);
assertEq("abc".indexOf("z"), -1);
assertEq("abcdef".substr(1, 3), "bcd");
assertEq("abcdef".substr(-2), "ef");
assertEq("ab".repeat(3), "ababab");
// An empty text repeats to an empty text for any count, including a huge one:
// the loop must not run for an empty text (`"".repeat(INT64_MAX)` used to spin
// through the full count). A zero count is empty too.
assertEq("".repeat(0), "");
assertEq("".repeat(5), "");
assertEq("".repeat(9223372036854775807), "");
assertEq("ab".repeat(0), "");
assertEq(pcall(() => "a".repeat(-1)).ok, false);
assertEq(pcall(() => "a".repeat(1000000000)).ok, false);
assertEq("abc".reversed(), "cba");
assertEq("5".padStart(3, "0"), "005");
assertEq("5".padEnd(3, "0"), "500");
assertEq("a\nb".lines(), ["a", "b"]);
assertEq("hello" + " " + "world", "hello world");
assertEq("abc"[1], "b");
assertEq("abc"[-1], "c");
assertEq("multi
line", "multi" + chr(10) + "line");

print("strings ok");
