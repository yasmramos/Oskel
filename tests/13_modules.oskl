// PHASE 6.5 §18: Java-style imports, module resolution and conflict detection.
//
// Fixtures live in tests/modules/ and resolve relative to this file's
// directory: `import modules.util;` -> tests/modules/util.oskl.

// --- qualified import: `import path;` -> access is path.name ---------------
import modules.util;
print(modules.util.answer);
print(modules.util.square(5));
print(modules.util.cube(3));

// --- the qualified import also binds the last segment ----------------------
// `import modules.util;` binds `util` when that name is free, so the module is
// reachable without repeating the whole path.
print(util.answer);
print(util.square(5));

// --- alias: `import path as name;` -----------------------------------------
import modules.util as u;
print(u.square(6));

// --- selective: `import { names } from path;` ------------------------------
import { square, cube } from modules.util;
print(square(7));
print(cube(2));

// `from` is a contextual keyword, not a reserved word: outside an import it is
// still an ordinary identifier.
let from = 7;
print(from);

// --- wildcard: `import path.*;` -> unqualified access ----------------------
import modules.other.*;
print(triple(4));

// --- two imports of the same module share one binding and one execution ----
import modules.util.*;
print(modules.util.answer);
print(answer);

// --- nested: a module that imports another module --------------------------
import modules.nested;
print(modules.nested.sumOfSquares(3, 4));

// --- an explicit alias wins over an earlier short name ---------------------
// `util` was the short name of modules.util; the alias below takes it over,
// while the full path stays available.
import modules.sub.util as util;
print(util.answer);              // 7: the explicit alias
print(modules.util.answer);      // 42: the full path still works
