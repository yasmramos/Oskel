// `std.semver`: the precedence chain, parsing, ranges (caret, tilde,
// wildcards, hyphen, conjunctions, disjunctions) and the error paths.
import std.semver.*;
import std.semver as sv;

let chain = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0"];
var i = 0;
while (i + 1 < len(chain)) {
  print("cmp", chain[i], "<", chain[i+1], "=", compare(chain[i], chain[i+1]));
  i = i + 1;
}

let v = parse("1.2.3-alpha.1+build.5");
print("parsed =", v);
print("format =", format(v));
print("vprefix =", format(parse("v1.2.3")));
print("build ignored =", compare("1.2.3+a", "1.2.3+b"));
print("stable =", isStable("1.2.3"), isPrerelease("1.2.3-beta"));
print("bump =", bump("1.2.3", "major"), bump("1.2.3", "minor"), bump("1.2.3", "patch"));

for bad in ["1.2", "1.2.3.4", "01.2.3", "1.2.3-01", "1.2.3-", "1.2.3+", "1.2.3-alpha..1", "1.2.3-alpha_beta", ""] {
  print("bad", bad, "=", isValid(bad), tryParse(bad).ok);
}
print("bad nonstr =", tryParse(42).ok);

let cases = [
  ["1.2.3", "1.2.3", true], ["1.2.3", "1.2.4", false],
  ["1.2.3", "^1.2.3", true], ["1.9.9", "^1.2.3", true], ["2.0.0", "^1.2.3", false], ["1.2.2", "^1.2.3", false],
  ["0.2.3", "^0.2.3", true], ["0.2.9", "^0.2.3", true], ["0.3.0", "^0.2.3", false],
  ["0.0.3", "^0.0.3", true], ["0.0.4", "^0.0.3", false],
  ["0.0.0", "^0.0", true], ["0.0.9", "^0.0", true], ["0.1.0", "^0.0", false],
  ["1.2.3", "~1.2.3", true], ["1.2.9", "~1.2.3", true], ["1.3.0", "~1.2.3", false],
  ["1.2.0", "~1.2", true], ["1.2.9", "~1.2", true], ["1.3.0", "~1.2", false],
  ["1.0.0", "~1", true], ["1.9.0", "~1", true], ["2.0.0", "~1", false],
  ["1.0.0", "1.x", true], ["1.9.9", "1.x", true], ["2.0.0", "1.x", false],
  ["1.2.0", "1.2.x", true], ["1.2.9", "1.2.x", true], ["1.3.0", "1.2.x", false],
  ["1.0.0", "*", true], ["0.0.1", "*", true], ["1.0.0-beta", "*", false],
  ["1.5.0", ">=1.2.3 <2.0.0", true], ["2.0.0", ">=1.2.3 <2.0.0", false],
  ["1.3.0", ">1.2", true], ["1.2.9", ">1.2", false], ["1.2.0", ">1.2", false],
  ["1.2.9", "<=1.2", true], ["1.3.0", "<=1.2", false],
  ["1.2.0", ">=1.2", true], ["1.1.9", ">=1.2", false],
  ["1.1.9", "<1.2", true], ["1.2.0", "<1.2", false],
  ["1.2.3", "1.2.3 - 2.3.4", true], ["2.3.4", "1.2.3 - 2.3.4", true], ["2.3.5", "1.2.3 - 2.3.4", false], ["1.2.2", "1.2.3 - 2.3.4", false],
  ["1.2.0", "1.2 - 2.3", true], ["2.3.9", "1.2 - 2.3", true], ["2.4.0", "1.2 - 2.3", false],
  ["1.5.0", "1.x || >=3.0.0", true], ["3.1.0", "1.x || >=3.0.0", true], ["2.0.0", "1.x || >=3.0.0", false],
  ["1.2.3-beta.2", ">=1.2.3-beta", true], ["1.2.4-beta", ">=1.2.3-beta", false], ["1.2.3", ">=1.2.3-beta", true],
  ["1.2.3-beta.2", "^1.2.3-beta", true], ["1.2.4-beta", "^1.2.3-beta", false],
  ["1.2.3-beta", "1.2.3-beta", true], ["1.2.3-beta.1", "1.2.3-beta", false],
  ["1.0.0-beta", ">=1.0.0", false], ["1.0.0-beta", ">=1.0.0-alpha", true],
  ["1.2.3+build", "1.2.3", true],
];
var failures = 0;
for c in cases {
  let got = satisfies(c[0], c[1]);
  if (got != c[2]) {
    failures = failures + 1;
    print("FAIL", c[0], c[1], "expected", c[2], "got", got);
  }
}
print("satisfies failures =", failures);
print("requirement =", parseRequirement("^1.2.3"));
print("bad req =", pcall(() => satisfies("1.0.0", "^")).ok);
print("bad req2 =", pcall(() => satisfies("1.0.0", ">=1.2.3.4")).ok);
print("bad bump =", pcall(() => bump("1.2.3", "nope")).ok);
print("semver ok");
