// Fixture for `oskel build` (tests/build_binary.cmake): the bound string
// methods under the AOT backend (PHASE 7c.3i).
//
// Every method `bindString` exposes must behave exactly like the development
// VM, so the fixture prints the result of each one and `build_binary.cmake`
// compares the compiled binary's output with the VM's byte for byte. The cases
// cover ASCII and multibyte UTF-8, the empty string, the optional arguments
// (`substr` length, `repeat` count) and the edges the hosted implementation
// defines: a negative `substr` start, a start past the end, a zero count.

print("--- case mapping ---");
print("upper ascii   =", "hello, world".upper());
print("lower ascii   =", "HELLO, WORLD".lower());
print("upper mixed   =", "Hello World 123".upper());
print("lower mixed   =", "Hello World 123".lower());
print("upper unicode =", "straße café".upper());
print("lower unicode =", "STRASSE CAFÉ".lower());
print("upper empty   =", "".upper());
print("lower empty   =", "".lower());

print("--- trim ---");
print("trim          = [" + "  padded  ".trim() + "]");
print("trimStart     = [" + "  padded  ".trimStart() + "]");
print("trimEnd       = [" + "  padded  ".trimEnd() + "]");
print("trim all      = [" + "     ".trim() + "]");
print("trim none     = [" + "none".trim() + "]");
print("trim tabs     = [" + "\t\n mixed \r\n".trim() + "]");

print("--- search ---");
print("contains yes  =", "hello world".contains("lo wo"));
print("contains no   =", "hello world".contains("xyz"));
print("contains self =", "abc".contains("abc"));
print("startsWith y  =", "hello".startsWith("he"));
print("startsWith n  =", "hello".startsWith("lo"));
print("startsWith big=", "he".startsWith("hello"));
print("endsWith y    =", "hello".endsWith("lo"));
print("endsWith n    =", "hello".endsWith("he"));
print("endsWith big  =", "lo".endsWith("hello"));
print("indexOf found =", "hello world".indexOf("world"));
print("indexOf first =", "abcabc".indexOf("abc"));
print("indexOf miss  =", "hello".indexOf("xyz"));
print("indexOf empty =", "hello".indexOf(""));
print("indexOf uni   =", "héllo".indexOf("llo"));

print("--- substr ---");
print("substr start  =", "hello world".substr(6));
print("substr len    =", "hello world".substr(0, 5));
print("substr middle =", "hello world".substr(3, 4));
print("substr neg    =", "hello".substr(-3));
print("substr past   =", "hello".substr(10));
print("substr zero   =", "hello".substr(1, 0));
print("substr neglen =", "hello".substr(1, -2));
print("substr uni    =", "héllo wörld".substr(2, 5));
print("substr empty  = [" + "".substr(0) + "]");

print("--- reversed ---");
print("reversed ascii=", "hello".reversed());
print("reversed uni  =", "héllo".reversed());
print("reversed empty=", "".reversed());
print("reversed one  =", "a".reversed());

print("--- repeat ---");
print("repeat 3      =", "ab".repeat(3));
print("repeat 0      = [" + "ab".repeat(0) + "]");
print("repeat 1      =", "ab".repeat(1));
print("repeat empty  = [" + "".repeat(5) + "]");
print("repeat uni    =", "é".repeat(3));

print("--- chained ---");
print("chain         =", "  Hello World  ".trim().lower().reversed());
print("chain2        =", "abc".upper().repeat(2).substr(1, 3));

print("--- empty needle and empty receiver ---");
print("contains empty =", "abc".contains(""));
print("startsWith emp =", "abc".startsWith(""));
print("endsWith empty =", "abc".endsWith(""));
print("empty contains =", "".contains(""));
print("empty starts   =", "".startsWith(""));
print("empty ends     =", "".endsWith(""));

print("--- non-latin UTF-8 ---");
print("indexOf greek  =", "αβγάβ".indexOf("άβ"));
print("substr neg uni =", "αβγδε".substr(-2));
print("substr len uni =", "αβγδε".substr(1, 2));
print("upper turkish  =", "iığüşöç".upper());
print("lower turkish  =", "IİĞÜŞÖÇ".lower());
print("trim mixed uni = [" + " \t\n αβ \r\n ".trim() + "]");
print("reversed greek =", "αβγ".reversed());
print("chain unicode  =", "  ÄBC  ".trim().lower().reversed());

print("--- split ---");
print("split sep     =", "a,b,c".split(","));
print("split empty f =", "a,,b".split(","));
print("split leading =", ",".split(","));
print("split trailing=", "a,".split(","));
print("split empty   =", "".split(","));
print("split miss    =", "no-sep".split("x"));
print("split whole   =", "abc".split("abc"));
print("split multi   =", "a::b::c".split("::"));
print("split ws      =", "  a  b  ".split());
print("split ws empty=", "".split());
print("split ws blank=", "   ".split());
print("split chars   =", "abc".split(""));
print("split chars sp=", "a b".split(""));
print("split chars u =", "héllo".split(""));

print("--- lines ---");
print("lines plain   =", "a\nb".lines());
print("lines empty   =", "".lines());
print("lines trailing=", "a\n".lines());
print("lines blank   =", "a\n\nb".lines());
print("lines crlf    =", "a\r\nb\r\n".lines());
print("lines only nl =", "\n".lines());
print("lines one     =", "abc".lines());
print("lines cr mid  =", "a\r\n\r\nb".lines());

print("--- chars ---");
print("chars ascii   =", "abc".chars());
print("chars empty   =", "".chars());
print("chars uni     =", "héllo".chars());
print("chars greek   =", "αβγ".chars());
print("chars len     =", len("αβγ".chars()));

print("--- replace / replaceFirst ---");
print("replace one   =", "abc".replace("b", "X"));
print("replace all   =", "aaa".replace("a", "bb"));
print("replace none  =", "abc".replace("z", "X"));
print("replace empty =", "abc".replace("abc", ""));
print("replaceFirst  =", "aaa".replaceFirst("a", "bb"));
print("replaceFirst n=", "abc".replaceFirst("z", "X"));
print("replaceFirst e=", "abc".replaceFirst("abc", "xyz"));

print("--- padStart / padEnd ---");
print("padStart zero =", "5".padStart(3, "0"));
print("padEnd zero   =", "5".padEnd(3, "0"));
print("padStart clip =", "ab".padStart(5, "xy"));
print("padEnd clip   =", "ab".padEnd(5, "xy"));
print("padStart space=", "[" + "ab".padStart(5) + "]");
print("padEnd space  =", "[" + "ab".padEnd(5) + "]");
print("padStart wide =", "abcdef".padStart(3));
print("padEnd wide   =", "abcdef".padEnd(3));
print("padStart empty=", "".padStart(3, "-"));
print("padEnd empty  =", "".padEnd(3, "-"));
print("padStart exact=", "abc".padStart(3, "0"));
print("padStart uni   =", "日本".padStart(5, "-"));
print("padStart ufill =", "a".padStart(4, "日本"));

print("--- chained collection methods ---");
print("chain split   =", "a,b,c".split(",").reversed());
print("chain lines   =", "a\nb\nc".lines());
print("chain chars   =", "x".repeat(3).split(""));
print("chain replace =", "aaa".replace("a", "bb").lines());
print("chain len     =", len("a b c".split()));
print("chain loop    =");
var parts = "1-2-3".split("-");
for p in parts { print("  part =", p); }

print("--- pad and split edges ---");
print("padStart neg  =", "[" + "abc".padStart(-5) + "]");
print("padEnd neg    =", "[" + "abc".padEnd(-5) + "]");
print("padStart zero =", "[" + "abc".padStart(0) + "]");
print("padEnd ufill  =", "[" + "a".padEnd(5, "日本") + "]");
print("padStart multi=", "[" + "a".padStart(6, "abc") + "]");
print("padEnd multi  =", "[" + "a".padEnd(6, "abc") + "]");
print("lines cr only =", "\r".lines());
print("lines trail cr=", "a\r".lines());
print("lines crnl    =", "\r\n".lines());
print("split space   =", "a b".split(" "));
print("split sp edge =", " a b ".split(" "));
print("split overlap =", "aaa".split("aa"));
print("split overlap2=", "aaaa".split("aa"));
