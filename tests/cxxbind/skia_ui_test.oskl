import std.internal.skia as skia;
import std.internal.skia_ui as skia_ui;
import std.ui as ui;

fn assertEq(actual: int, expected: int) {
  if (actual != expected) {
    panic("expected " + str(expected) + ", got " + str(actual));
  }
}

fn assertEqStr(actual: string, expected: string) {
  if (actual != expected) {
    panic("expected '" + expected + "', got '" + actual + "'");
  }
}

let root = ui.Window("Demo", 120, 80,
  ui.Column(8, [
    ui.Text("Hi", 16),
    ui.Button("OK", () => nil),
  ]));
ui.layout(root, 120, 80);

let commands = ui.commands(root);
assertEq(len(commands), 4);
assertEqStr(commands[0].kind, "rect");
assertEqStr(commands[1].kind, "text");
assertEqStr(commands[2].kind, "rect");
assertEqStr(commands[3].kind, "text");

let hit = ui.hitTest(root, 10, 40);
assert(hit != nil);
assertEqStr(hit.label, "OK");
assert(ui.hitTest(root, 100, 75) == nil);

let surface = skia.Surfaces.raster(120, 80);
let canvas = surface.getCanvas();
skia_ui.render(commands, canvas);

let image = surface.makeImageSnapshot();
assertEq(skia.imagePixel(image, 100, 75), 0xFFFFFFFF);
assertEq(skia.imagePixel(image, 10, 40), 0xFF2563EB);
image.close();
canvas.close();
surface.close();

// A checkbox paints its box in every pointer state and fills it when checked.
let control = ui.Window("Check", 120, 24,
  ui.Checkbox("Accept", false, (checked) => nil));
ui.layout(control, 120, 24);
let controlSurface = skia.Surfaces.raster(120, 24);
let controlCanvas = controlSurface.getCanvas();
skia_ui.render(ui.commands(control), controlCanvas);
let uncheckedImage = controlSurface.makeImageSnapshot();
assertEq(skia.imagePixel(uncheckedImage, 8, 8), 0xFFE5E7EB);
uncheckedImage.close();

_ = ui.pointerMove(control, 8, 8);
skia_ui.render(ui.commands(control), controlCanvas);
let hoverImage = controlSurface.makeImageSnapshot();
assertEq(skia.imagePixel(hoverImage, 8, 8), 0xFFD1D5DB);
hoverImage.close();

_ = ui.pointerDown(control, 8, 8);
skia_ui.render(ui.commands(control), controlCanvas);
let pressedImage = controlSurface.makeImageSnapshot();
assertEq(skia.imagePixel(pressedImage, 8, 8), 0xFF9CA3AF);
pressedImage.close();

assert(ui.pointerUp(control, 8, 8));
skia_ui.render(ui.commands(control), controlCanvas);
let checkedImage = controlSurface.makeImageSnapshot();
assertEq(skia.imagePixel(checkedImage, 8, 8), 0xFF2563EB);
checkedImage.close();
controlCanvas.close();
controlSurface.close();
print("skia ui ok");
