// PHASE 11.2.2 VM/AOT/WASM parity: the scheduler is ordinary Oskel over maps
// and arrays, so all three engines must produce the same order. The body is
// still one eager step; 11.2.3 adds suspension at `await`.
var log: array = [];

fn note(text: string): void {
  log.push(text);
}

async fn task(id: int): int {
  note("start " + str(id));
  yield();
  note("end " + str(id));
  return id * 10;
}

async fn main(): void {
  let a = spawn task(1);
  let b = spawn task(2);
  note("spawned");
  assertEq(await a, 10);
  note("a");
  assertEq(await b, 20);
  note("b");
  let c = task(3);
  assertEq(await c, 30);
  assertEq(await c, 30);
  for line in log {
    print(line);
  }
  print("async scheduler native ok");
}

main();
