// Fixture for `oskel build` (tests/build_binary.cmake).
//
// `+` on two arrays concatenates them (docs/language.md: "concatenation of
// strings or arrays"). The hosted engine builds a fresh array and leaves both
// operands unchanged; the AOT backend used to reject the pair at runtime
// ("unsupported operand types"), so a compiled binary disagreed with the VM.
// This fixture is checked against the VM, so the array path of the backend is
// pinned by a real program.

print([1, 2] + [3, 4]);
print([] + []);
print([] + [9]);
print([9] + []);
print(["x", "y"] + ["z"]);
print([[1], [2]] + [[3]]);
print([1, "a", true] + [nil, 2.5]);

// The operands are read only: `+` must not mutate either side.
var a = [1, 2];
var b = [3];
var c = a + b;
print(a);
print(b);
print(c);
print(a.length, b.length, c.length);

// Concatenation inside a loop, growing an accumulator one element at a time.
var acc = [];
var i = 0;
while (i < 4) {
  acc = acc + [i * i];
  i = i + 1;
}
print(acc);

// A concatenation feeding a `for` loop and a sum, so the result is consumed,
// not only printed.
var total = 0;
for v in ([10, 20] + [30, 40]) {
  total = total + v;
}
print(total);
