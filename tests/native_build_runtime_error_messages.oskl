// A runtime error message is part of the observable behaviour: a program that
// reports a failure through `pcall` reads `error.message`, so the VM and a
// native binary must word it the same way. The type, member, index and
// two-operand (`cannot compare`, `in`) tails are assembled at run time, so they
// are compared exactly; the arithmetic/bitwise operand tail still keeps only
// the fixed prefix (BACKLOG §6 item 25).

fn message(f) {
  let result = pcall(f);
  if (result.ok) {
    return "<no error>";
  }
  return result.error.message;
}

fn expectExact(f, expected) {
  let actual = message(f);
  assertEq(actual, expected);
}

fn expectPrefix(f, prefix) {
  let actual = message(f);
  assert(actual.startsWith(prefix), "expected prefix '" + prefix + "', got '" + actual + "'");
}

// The messages the AOT backend words exactly like the VM.
expectExact(() => { let a = [1]; return a["x"]; }, "array index must be an integer");
expectExact(() => { let s = "a"; return s["x"]; }, "string index must be an integer");
expectExact(() => { // A callback method names itself when the argument is not a function, and only
// once it invokes it: an empty receiver never reports it, exactly as in the VM.
expectExact(() => [1].map(1), "map() must be a function, got 'int'");
expectExact(() => [1].filter("x"), "filter() must be a function, got 'string'");
expectExact(() => [1].each(nil), "each() must be a function, got 'nil'");
expectExact(() => [1].find(1.5), "find() must be a function, got 'double'");
expectExact(() => [1].any([1]), "any() must be a function, got 'array'");
expectExact(() => [1].all(({})), "all() must be a function, got 'map'");
expectExact(() => [1, 2].reduce(1), "reduce() must be a function, got 'int'");
assertEq(str([].map(1)), "[]", "an empty receiver never calls the callback");

// An operand pair the operator cannot take names the operator and both types,
// so the selector the runtime already carries picks the prefix.
expectExact(() => 1 + "a", "unsupported operand types for '+': 'int' and 'string'");
expectExact(() => "a" + 1, "unsupported operand types for '+': 'string' and 'int'");
expectExact(() => 1 - nil, "unsupported operand types for '-': 'int' and 'nil'");
expectExact(() => 1 * [1], "unsupported operand types for '*': 'int' and 'array'");
expectExact(() => 1 / (({})), "unsupported operand types for '/': 'int' and 'map'");
expectExact(() => 1 % "a", "unsupported operand types for '%': 'int' and 'string'");
expectExact(() => 1 & 1.5, "unsupported operand types for '&': 'int' and 'double'");
expectExact(() => 1 | "a", "unsupported operand types for '|': 'int' and 'string'");
expectExact(() => 1 ^ nil, "unsupported operand types for '^': 'int' and 'nil'");
expectExact(() => 1 << "a", "unsupported operand types for '<<': 'int' and 'string'");
expectExact(() => 1 >> nil, "unsupported operand types for '>>': 'int' and 'nil'");
expectExact(() => 2 ** "a", "unsupported operand types for '**': 'int' and 'string'");
expectExact(() => 1 << 64, "shift count must be between 0 and 63");

let m = {"a": 1}; return m[1]; }, "map keys must be strings");
expectExact(() => { let m = {"a": 1}; m[1] = 2; return 0; }, "map keys must be strings");
expectExact(() => 1 in {"a": 1}, "map membership requires a string key");
expectExact(() => 1 in "abc", "string membership requires a string operand");
expectExact(() => 1.5 in 1..3, "range membership requires an integer");

// The type tail is assembled at run time, so these are exact too.
expectExact(() => len(1), "len() is not defined for values of type 'int'");
expectExact(() => { for x in 1 { } }, "cannot iterate over a value of type 'int'");
expectExact(() => { for k, v in 1 { } },
            "cannot iterate over a value of type 'int'");
expectExact(() => { for k, v in [1] { } },
            "key/value iteration ('for k, v in ...') requires a map, got 'array'");
expectExact(() => -"a", "unsupported unary operator for type 'string'");
expectExact(() => ~"a", "unsupported unary operator for type 'string'");
expectExact(() => { let x = 1; return x["a":"b"]; },
            "cannot slice a value of type 'int'");
expectExact(() => fsRead(1, 1), "fsRead() expects a file handle, got 'int'");
expectExact(() => fsRead(cstring("a"), 1), "fsRead() expects a file handle, got 'cstring'");
expectExact(() => fsClose(1), "fsClose() expects a file handle, got 'int'");
expectExact(() => fsWrite(1, "x"), "fsWrite() expects a file handle, got 'int'");
expectExact(() => fsRemove(1), "fsRemove() expects a string path, got 'int'");
expectExact(() => fsRename(1, "b"), "fsRename() expects a string source path, got 'int'");
expectExact(() => fsRename("a", 2),
            "fsRename() expects a string destination path, got 'int'");
expectExact(() => { let x = 1; return x[0]; }, "cannot index a value of type 'int'");
expectExact(() => { let x = 1; x[0] = 2; return 0; },
            "cannot assign to an index of a value of type 'int'");
expectExact(() => { let x = 1; return x.foo; }, "type 'int' has no member 'foo'");
expectExact(() => { let x = 1; x.foo = 2; return 0; },
            "cannot set a field on a value of type 'int'");
expectExact(() => { let x = 1; return x(); }, "cannot call a value of type 'int'");

// The bound methods and the range builtin name their argument in the tail too.
expectExact(() => [1].slice("x"), "slice() expects an integer start, got 'string'");
expectExact(() => [1].slice(0, "x"), "slice() expects an integer end, got 'string'");
expectExact(() => [1].insert("x", 2), "insert() expects an integer index, got 'string'");
expectExact(() => [1].removeAt("x"), "removeAt() expects an integer index, got 'string'");
expectExact(() => "a".substr("x"), "substr() expects an integer start, got 'string'");
expectExact(() => "a".substr(0, "x"), "substr() expects an integer length, got 'string'");
expectExact(() => "a".repeat("x"), "repeat() expects an integer count, got 'string'");
expectExact(() => range(1, "x"), "range() expects an integer end, got 'string'");
expectExact(() => "a".contains(1), "contains() expects a string text, got 'int'");
expectExact(() => "a".startsWith(1), "startsWith() expects a string prefix, got 'int'");
expectExact(() => "a".endsWith(1), "endsWith() expects a string suffix, got 'int'");
expectExact(() => "a".indexOf(1), "indexOf() expects a string text, got 'int'");
expectExact(() => "a".split(1), "split() expects a string separator, got 'int'");
expectExact(() => "a".replace(1, "b"), "replace() expects a string search text, got 'int'");
expectExact(() => "a".replace("a", 1), "replace() expects a string replacement text, got 'int'");
expectExact(() => "a".replaceFirst(1, "b"),
            "replaceFirst() expects a string search text, got 'int'");
expectExact(() => "a".replaceFirst("a", 1),
            "replaceFirst() expects a string replacement text, got 'int'");
expectExact(() => "a".padStart("x"), "padStart() expects an integer width, got 'string'");
expectExact(() => "a".padStart(3, 1), "padStart() expects a string fill, got 'int'");
expectExact(() => "a".padEnd("x"), "padEnd() expects an integer width, got 'string'");
expectExact(() => "a".padEnd(3, 1), "padEnd() expects a string fill, got 'int'");
let m = {"a": 1};
expectExact(() => m.has(1), "has() expects a string key, got 'int'");
expectExact(() => m.get(1), "get() expects a string key, got 'int'");
expectExact(() => m.set(1, 2), "set() expects a string key, got 'int'");
expectExact(() => m.delete(1), "delete() expects a string key, got 'int'");

// The pointer and numeric builtins quote the argument's type too.
expectExact(() => free(1), "free() expects a pointer, got 'int'");
expectExact(() => buffer("x"), "buffer() expects an integer size, got 'string'");
expectExact(() => cstring(1), "cstring() expects a string argument, got 'int'");
expectExact(() => cstr(1), "cstr() expects a pointer argument, got 'int'");
expectExact(() => byteLen(1), "byteLen() expects a pointer argument, got 'int'");
expectExact(() => loadByte(1, 0), "loadByte() expects a pointer value, got 'int'");
expectExact(() => storeByte(1, 0, 0), "storeByte() expects a pointer value, got 'int'");
expectExact(() => intToPtr("x"), "intToPtr() expects an integer token, got 'string'");
expectExact(() => ptrToInt(1), "ptrToInt() expects a pointer argument, got 'int'");
expectExact(() => chr("a"), "chr() expects an integer argument, got 'string'");
expectExact(() => ord(1), "ord() expects a string argument, got 'int'");
expectExact(() => sqrt("a"), "sqrt() expects a number argument, got 'string'");
expectExact(() => floor("a"), "floor() expects a number argument, got 'string'");
expectExact(() => error("m", "x"), "error() expects an integer code, got 'string'");
expectExact(() => fsOpen(1, "r"), "fsOpen() expects a string path, got 'int'");

// The two-type tails quote both operands. `&` still keeps only its prefix: the
// arithmetic/bitwise helper is shared by every operator and does not receive
// the symbol, so that message has no operator to name.
// `>` and `<=` are lowered to `lessThan(b, a)` in the VM, so its message
// quotes the operands reversed; the AOT backend matches that.
expectExact(() => 1 < "a", "cannot compare 'int' with 'string'");
expectExact(() => 1 <= "a", "cannot compare 'string' with 'int'");
expectExact(() => 1 > "a", "cannot compare 'string' with 'int'");
expectExact(() => 1 >= "a", "cannot compare 'int' with 'string'");
expectExact(() => 1 in 2, "operator 'in' is not supported for 'int' and 'int'");
expectPrefix(() => "a" & 1, "unsupported operand types for");

print("runtime error messages ok");
