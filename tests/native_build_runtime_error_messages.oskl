// A runtime error message is part of the observable behaviour: a program that
// reports a failure through `pcall` reads `error.message`, so the VM and a
// native binary must word it the same way. The messages without a dynamic tail
// are compared exactly; the ones that quote a type or member name keep the
// VM's fixed prefix and the tail is allowed to differ (BACKLOG §6 item 25).

fn message(f) {
  let result = pcall(f);
  if (result.ok) {
    return "<no error>";
  }
  return result.error.message;
}

fn expectExact(f, expected) {
  let actual = message(f);
  assertEq(actual, expected);
}

fn expectPrefix(f, prefix) {
  let actual = message(f);
  assert(actual.startsWith(prefix), "expected prefix '" + prefix + "', got '" + actual + "'");
}

// The member message puts the type name between the two fixed words, so the
// VM's `type 'int' has no member 'foo'` and the AOT's `type has no member`
// share no longer a prefix than `type`. Both words are still asserted.
fn expectMember(f) {
  let actual = message(f);
  assert(actual.startsWith("type"), "expected 'type ...', got '" + actual + "'");
  assert(actual.contains("has no member"), "expected 'has no member', got '" + actual + "'");
}

// The messages the AOT backend words exactly like the VM.
expectExact(() => { let a = [1]; return a["x"]; }, "array index must be an integer");
expectExact(() => { let s = "a"; return s["x"]; }, "string index must be an integer");
expectExact(() => { let m = {"a": 1}; return m[1]; }, "map keys must be strings");
expectExact(() => { let m = {"a": 1}; m[1] = 2; return 0; }, "map keys must be strings");
expectExact(() => 1 in {"a": 1}, "map membership requires a string key");
expectExact(() => 1 in "abc", "string membership requires a string operand");
expectExact(() => 1.5 in 1..3, "range membership requires an integer");

// The fixed prefix of every message that quotes a dynamic tail.
expectPrefix(() => len(1), "len() is not defined for values of type");
expectPrefix(() => { for x in 1 { } }, "cannot iterate over a value of type");
expectPrefix(() => -"a", "unsupported unary operator for type");
expectPrefix(() => ~"a", "unsupported unary operator for type");
expectPrefix(() => "a" & 1, "unsupported operand types for");
expectPrefix(() => { let x = 1; return x["a":"b"]; },
             "cannot slice a value of type");
expectPrefix(() => fsRead(1, 1), "fsRead() expects a file handle");
expectPrefix(() => fsClose(1), "fsClose() expects a file handle");
expectPrefix(() => { let x = 1; return x[0]; }, "cannot index a value of type");
expectPrefix(() => { let x = 1; x[0] = 2; return 0; },
             "cannot assign to an index of a value of type");
expectMember(() => { let x = 1; return x.foo; });
expectPrefix(() => { let x = 1; x.foo = 2; return 0; },
             "cannot set a field on a value of type");
expectPrefix(() => { let x = 1; return x(); }, "cannot call a value of type");
expectPrefix(() => 1 in 2, "operator 'in' is not supported for");

print("runtime error messages ok");
