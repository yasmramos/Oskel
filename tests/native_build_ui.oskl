// `std.ui` is pure Oskel over the portable primitive surface: layout, display
// list and hit testing must agree on the VM and under `oskel build`.
import std.ui as ui;

fn assertEq(actual, expected) {
  if (actual != expected) {
    panic("expected " + str(expected) + ", got " + str(actual));
  }
}

let root = ui.window("Demo", 200, 120,
  ui.column(8, [
    ui.text("Hello", 20),
    ui.button("OK", () => nil),
  ]));
ui.layout(root, 200, 120);

let commands = ui.commands(root);
assertEq(len(commands), 4);
assertEq(commands[0].kind, "rect");
assertEq(commands[1].kind, "text");
assertEq(commands[1].text, "Hello");
assertEq(commands[2].kind, "rect");
assertEq(commands[3].kind, "text");
assertEq(commands[3].text, "OK");
assertEq(commands[2].color, 0xFF2563EB);

let hit = ui.hitTest(root, 10, 40);
assert(hit != nil);
assertEq(hit.label, "OK");
assert(ui.hitTest(root, 190, 110) == nil);

// Pointer states: hover, press and release all repaint the same button.
let button = root.child.children[1];
assertEq(button.hover, false);
assertEq(button.pressed, false);
assert(ui.pointerMove(root, 10, 40));
assertEq(button.hover, true);
assertEq(ui.commands(root)[2].color, 0xFF1D4ED8);
assert(!ui.pointerMove(root, 10, 40));
assert(ui.pointerDown(root, 10, 40));
assertEq(button.pressed, true);
assertEq(ui.commands(root)[2].color, 0xFF1E40AF);
assertEq(ui.pointerUp(root, 10, 40), true);
assertEq(button.pressed, false);
assertEq(button.hover, true);
assertEq(ui.commands(root)[2].color, 0xFF1D4ED8);
assert(ui.pointerMove(root, 190, 110));
assertEq(button.hover, false);
assertEq(ui.commands(root)[2].color, 0xFF2563EB);

// A release outside the button cancels the press without running the handler.
assert(ui.pointerDown(root, 10, 40));
assertEq(ui.pointerUp(root, 190, 110), false);
assertEq(button.pressed, false);

// Leaving the window clears both states.
_ = ui.pointerMove(root, 10, 40);
_ = ui.pointerDown(root, 10, 40);
assert(ui.pointerCancel(root));
assertEq(button.hover, false);
assertEq(button.pressed, false);
assert(!ui.pointerCancel(root));

// A complete click still works for headless callers.
var clicks = 0;
let clickable = ui.window("Click", 80, 30,
  ui.button("Go", () => clicks = clicks + 1));
ui.layout(clickable, 80, 30);
assertEq(ui.click(clickable, 10, 10), true);
assertEq(clicks, 1);

// A checkbox is an input widget: it toggles on release over the widget and
// reports the new state to onChange.
var checks = 0;
var lastCheck = false;
fn onCheck(value) {
  checks = checks + 1;
  lastCheck = value;
}
let control = ui.window("Control", 180, 30,
  ui.column(0, [ui.checkbox("Accept", false, onCheck)]));
ui.layout(control, 180, 30);
let unchecked = ui.commands(control);
assertEq(len(unchecked), 3);
assertEq(unchecked[1].kind, "rect");
assertEq(unchecked[1].w, 16);
assertEq(unchecked[1].h, 16);
assertEq(unchecked[1].color, 0xFFE5E7EB);
assertEq(unchecked[2].kind, "text");
assertEq(unchecked[2].text, "Accept");
assertEq(unchecked[2].x, 24);
assertEq(unchecked[2].color, 0xFF000000);
let controlHit = ui.hitTest(control, 8, 8);
assert(controlHit != nil);
assertEq(controlHit.kind, "checkbox");

assert(ui.pointerMove(control, 8, 8));
assertEq(ui.commands(control)[1].color, 0xFFD1D5DB);
assert(ui.pointerDown(control, 8, 8));
assertEq(ui.commands(control)[1].color, 0xFF9CA3AF);
assertEq(ui.pointerUp(control, 8, 8), true);
assertEq(checks, 1);
assertEq(lastCheck, true);
assertEq(controlHit.checked, true);
let checked = ui.commands(control);
assertEq(len(checked), 4);
assertEq(checked[1].color, 0xFFD1D5DB);
assertEq(checked[2].color, 0xFF2563EB);
assertEq(checked[2].w, 8);
assertEq(checked[2].h, 8);
assertEq(checked[3].text, "Accept");

assertEq(ui.click(control, 8, 8), true);
assertEq(checks, 2);
assertEq(lastCheck, false);
assertEq(controlHit.checked, false);
assertEq(len(ui.commands(control)), 3);

// A row places the next widget after the checkbox's measured width.
let measuredCheck = ui.window("Check row", 200, 30,
  ui.row(0, [
    ui.checkbox("A", false, (checked) => nil),
    ui.text("B", 10),
  ]));
ui.layout(measuredCheck, 200, 30);
let checkRow = ui.commands(measuredCheck);
assertEq(checkRow[1].w, 16);
assertEq(checkRow[2].text, "A");
assertEq(checkRow[3].text, "B");
assertEq(checkRow[3].x, 32);

// A release outside the checkbox cancels the press without toggling it.
assert(ui.pointerDown(control, 8, 8));
assertEq(ui.pointerUp(control, 150, 25), false);
assertEq(controlHit.checked, false);
assertEq(checks, 2);

// Leaving the window clears the pointer state without changing the value.
_ = ui.pointerMove(control, 8, 8);
_ = ui.pointerDown(control, 8, 8);
assert(ui.pointerCancel(control));
assertEq(controlHit.hover, false);
assertEq(controlHit.pressed, false);
assertEq(controlHit.checked, false);

// Explicit state colours.
let custom = ui.window("Custom", 80, 30,
  ui.buttonStates("X", () => nil, 0xFF111111, 0xFF222222, 0xFF333333,
                  0xFFFFFFFF));
ui.layout(custom, 80, 30);
assertEq(ui.commands(custom)[1].color, 0xFF111111);
_ = ui.pointerMove(custom, 10, 10);
assertEq(ui.commands(custom)[1].color, 0xFF222222);
_ = ui.pointerDown(custom, 10, 10);
assertEq(ui.commands(custom)[1].color, 0xFF333333);
_ = ui.pointerUp(custom, 10, 10);
assertEq(ui.commands(custom)[1].color, 0xFF222222);

// A row with a padded button and a spacer.
let bar = ui.window("Bar", 100, 40,
  ui.row(4, [
    ui.text("A", 10),
    ui.padding(2, ui.button("B", () => nil)),
    ui.spacer(5),
  ]));
ui.layout(bar, 100, 40);
let barCommands = ui.commands(bar);
assertEq(len(barCommands), 4);
assertEq(barCommands[1].text, "A");
assertEq(barCommands[2].x, 12);
assertEq(barCommands[3].text, "B");
let barHit = ui.hitTest(bar, 20, 20);
assert(barHit != nil);
assertEq(barHit.label, "B");

// A renderer-supplied measurer drives the row: the button starts after the
// text's real advance, not after the fixed headless advance.
fn wide(text, size): int {
  return len(text) * size * 2;
}
let measured = ui.window("Measured", 200, 60,
  ui.row(0, [
    ui.text("A", 10),
    ui.button("B", () => nil),
  ]));
ui.layoutWith(measured, 200, 60, wide);
let measuredCommands = ui.commands(measured);
assertEq(measuredCommands[2].x, 20);
assertEq(measuredCommands[2].w, 52);
assertEq(measuredCommands[3].x, 32);

// Explicit colours: text and button styles.
let styled = ui.window("Styled", 60, 30,
  ui.buttonStyle("S", () => nil, 0xFF000000, 0xFFFFFFFF));
ui.layout(styled, 60, 30);
let styledCommands = ui.commands(styled);
assertEq(styledCommands[1].color, 0xFF000000);
assertEq(styledCommands[2].color, 0xFFFFFFFF);
_ = ui.pointerMove(styled, 10, 10);
assertEq(ui.commands(styled)[1].color, 0xFF000000);
_ = ui.pointerDown(styled, 10, 10);
assertEq(ui.commands(styled)[1].color, 0xFF000000);
_ = ui.pointerUp(styled, 10, 10);
assertEq(ui.commands(styled)[1].color, 0xFF000000);

let tinted = ui.window("Tinted", 40, 20, ui.textColor("T", 10, 0xFF00FF00));
ui.layout(tinted, 40, 20);
assertEq(ui.commands(tinted)[1].color, 0xFF00FF00);

print("ui ok");
