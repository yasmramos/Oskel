// PHASE 11.2.2: the cooperative task scheduler.
//
// Calling an `async fn` returns a *pending* future and enqueues its task;
// `spawn` is the explicit form. A body that suspends is split into continuation
// closures (PHASE 11.2.3), so `yield()` parks the task at the back of the ready
// queue and another task runs before it resumes. The expected log is therefore
// the FIFO order: both tasks start, then finish in the order they yielded.
//
// The script's pending tasks are drained before the process exits, so an
// `async fn main` needs no top-level `await`.

var log: array = [];

fn note(text: string): void {
  log.push(text);
}

async fn task(id: int): int {
  note("start " + str(id));
  yield();
  note("end " + str(id));
  return id * 10;
}

async fn main(): void {
  let a: Future = spawn task(1);
  let b: Future = spawn task(2);
  note("spawned");

  assertEq(await a, 10);
  note("a");
  assertEq(await b, 20);
  note("b");

  // A task created without `spawn` is still pending; awaiting it starts it.
  let c = task(3);
  assertEq(await c, 30);

  // Awaiting a settled future is immediate and stable.
  assertEq(await c, 30);

  assertEq(log.join(","),
           "spawned,start 1,start 2,end 1,end 2,a,b,start 3,end 3");
  print("async scheduler ok");
}

main();
