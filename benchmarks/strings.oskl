// Benchmark: build n short strings, join them with a comma, split them back and
// sum their lengths.
//
// This is the allocation-heavy half of the suite: every part is a fresh string,
// `join` builds one long one and `split` allocates n more. It is also the shape
// that exposed the allocator's register contract (docs/BACKLOG.md §6 item 34),
// so it doubles as a stress test of the arena.
//
// `n` is bounded by the AOT and WASM `join`, which concatenates incrementally
// and therefore allocates O(n^2) bytes (docs/BACKLOG.md §6 item 36): 5 000 parts
// already reach ~125 MB there, while the VM's `join` is linear. Raise it only
// after item 36 lands, otherwise the AOT column measures the allocator instead
// of the language.
var n = 5000;
var parts = [];
var i = 0;
while (i < n) {
  parts.push("item-" + str(i));
  i = i + 1;
}

var text = parts.join(",");
var words = text.split(",");
var chars = 0;
for w in words {
  chars = chars + len(w);
}
print("strings ${len(text)} ${len(words)} ${chars}");
