// Benchmark: build n short strings, join them with a comma, split them back and
// sum their lengths.
//
// This is the allocation-heavy half of the suite: every part is a fresh string,
// `join` builds one long one and `split` allocates n more. It is also the shape
// that exposed the allocator's register contract (docs/BACKLOG.md §6 item 34),
// so it doubles as a stress test of the arena.
//
// `n` was capped at 5 000 while the AOT and WASM `join` appended with a fresh
// concatenation per part and allocated O(n^2) bytes (docs/BACKLOG.md §6 item
// 36); with the linear `join` of that item, 20 000 is cheap everywhere.
var n = 20000;
var parts = [];
var i = 0;
while (i < n) {
  parts.push("item-" + str(i));
  i = i + 1;
}

var text = parts.join(",");
var words = text.split(",");
var chars = 0;
for w in words {
  chars = chars + len(w);
}
print("strings ${len(text)} ${len(words)} ${chars}");
